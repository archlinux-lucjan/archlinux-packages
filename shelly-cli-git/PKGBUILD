# Maintainer: Zoey Bauer <zoey.erin.bauer@gmail.com>
# Maintainer: Piotr Górski <lucjan.lucjanov@gmail.com>

pkgbase=shelly-cli-git
pkgname=('shelly-cli-git' 'shelly-cli-flatpak-backend-git')
_gitname=Shelly-ALPM
pkgver=3.0.6.r111.g8caea027
pkgrel=1
arch=('x86_64')
url='https://github.com/Seafoam-Labs/Shelly-ALPM'
license=('GPL-3.0-only')
makedepends=(
  'flatpak'
  'git'
  'go-md2man'
  'pkgconf'
  'zig>=0.16.0'
)
checkdepends=('ripgrep')
source=("${_gitname}::git+${url}.git#branch=development")
sha256sums=('SKIP')

_zig_build() {
  zig build \
    --cache-dir "${srcdir}/zig-cache" \
    --global-cache-dir "${srcdir}/zig-global-cache" \
    -Dcpu=baseline \
    "$@"
}

pkgver() {
  cd "${_gitname}"
  git describe --long --tags --abbrev=8 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "${_gitname}"

  (cd Shelly.Flatpak.Backend && _zig_build \
    --prefix "${srcdir}/zig-out-flatpak-backend" \
    -Doptimize=ReleaseSafe)

  (cd Shelly.Cli.Zig && _zig_build \
    --prefix "${srcdir}/zig-out" \
    -Doptimize=ReleaseSmall)

  local shelly="${srcdir}/zig-out/bin/shelly"

  for shell in bash fish zsh; do
    "${shelly}" utility --completions "${shell}" > "${srcdir}/shelly.${shell}"
  done

  "${shelly}" utility --docs | go-md2man > "${srcdir}/shelly.1"
  sed -i "s|^\\.TH .*|.TH \"SHELLY\" \"1\" \"\" \"Shelly CLI ${pkgver}\" \"Shelly CLI Manual\"|" \
    "${srcdir}/shelly.1"
  printf '\n.SH AUTHORS\nSeafoam Labs.\n' >> "${srcdir}/shelly.1"
}

check() {
  cd "${_gitname}"

  (cd Shelly.Flatpak.Backend && _zig_build test abi-test integration-test)
  (cd Shelly.PackageManager && _zig_build flatpak-test)
  (cd Shelly.Cli.Zig && _zig_build test)

  scripts/check-flatpak-separation.sh \
    "${srcdir}/zig-out/bin/shelly" \
    "${srcdir}/zig-out-flatpak-backend/lib/libshelly-flatpak-backend.so.1"
}

package_shelly-cli-git() {
  pkgdesc='Native Shelly package-manager CLI (git version)'
  depends=(
    'diffutils'
    'git'
    'glibc'
    'libarchive'
    'pacman'
    'sudo'
  )
  optdepends=(
    'base-devel: build and install AUR packages'
    'desktop-file-utils: update AppImage desktop entries'
    'devtools: build AUR packages in a clean chroot'
    'fuse2: run AppImages that require FUSE 2'
    'gtk-update-icon-cache: update AppImage icons'
    'opendoas: alternative privilege elevator to sudo'
    'plocate: locate-based pacfile discovery'
    'shelly-cli-flatpak-backend-git: Flatpak package management support'
    'vim: default visual pacfile diff viewer'
  )
  provides=("shelly-cli=${pkgver}")
  conflicts=('shelly-cli' 'shelly' 'shelly-git' 'shelly-bin')
  backup=('etc/shellybuild.conf')

  cd "${_gitname}"

  install -Dm755 "${srcdir}/zig-out/bin/shelly" -t "${pkgdir}/usr/bin"
  install -Dm644 shellybuild.conf -t "${pkgdir}/etc"

  install -Dm644 "${srcdir}/shelly.bash" "${pkgdir}/usr/share/bash-completion/completions/shelly"
  install -Dm644 "${srcdir}/shelly.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/shelly.fish"
  install -Dm644 "${srcdir}/shelly.zsh" "${pkgdir}/usr/share/zsh/site-functions/_shelly"
  install -Dm644 "${srcdir}/shelly.1" -t "${pkgdir}/usr/share/man/man1"
}

package_shelly-cli-flatpak-backend-git() {
  pkgdesc='Optional native Flatpak backend for the Shelly CLI (git version)'
  depends=("shelly-cli-git=${pkgver}-${pkgrel}" 'flatpak')
  provides=(
    "shelly-cli-flatpak-backend=${pkgver}"
    "shelly-flatpak-backend=${pkgver}"
  )
  conflicts=(
    'shelly-cli-flatpak-backend'
    'shelly-flatpak-backend'
    'shelly-flatpak-backend-bin'
    'shelly-flatpak-backend-git'
  )

  install -Dm755 \
    "${srcdir}/zig-out-flatpak-backend/lib/libshelly-flatpak-backend.so.1.0.0" \
    -t "${pkgdir}/usr/lib/shelly"
  ln -s libshelly-flatpak-backend.so.1.0.0 \
    "${pkgdir}/usr/lib/shelly/libshelly-flatpak-backend.so.1"
}
