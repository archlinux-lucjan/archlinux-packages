# Maintainer: Piotr Gorski <lucjan.lucjanov@gmail.com>

pkgname=helicoprion
pkgver=0.5.0
pkgrel=1
pkgdesc="Scheduler-focused CPU benchmark: detects EEVDF vs sched-ext, runs workloads, charts the difference"
arch=('x86_64' 'aarch64')
url="https://github.com/Seafoam-Labs/helicoprion"
license=('MIT OR Apache-2.0')
depends=('glibc' 'gcc-libs')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('1c2b31cf5084df7cb601cf9105c481a8155fa5fc3346fec9286c81b4b4f572df')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p helicoprion
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Fault-injection tests intentionally panic worker threads; the panic
  # messages on stderr are expected.
  cargo test --frozen --release --workspace
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname/"
  # README.md, and METHODOLOGY.md from 0.5.0 on: whatever the release has.
  install -Dm644 ./*.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
