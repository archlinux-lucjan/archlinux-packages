pkgbase=shelly-git
pkgname=(
  'shelly-git'
  'shelly-cli-git'
  'shelly-flatpak-backend-git'
  'shelly-tui-git'
  'shelly-notify-git'
  'shelly-notify-none-git'
)
pkgver=3.4.2.r3.g5613506a
pkgrel=1
arch=('x86_64' 'aarch64')
url='https://github.com/Seafoam-Labs/Shelly-ALPM'
license=('GPL-3.0-only')

# Use the RLPM-only native backend with Arch runtime paths.
# The pacman path profile selects /etc/pacman.conf and /var/lib/pacman;
# it does not enable libalpm.
_shelly_libalpm=false
_shelly_path_profile=pacman
_shelly_native_depends=()
_shelly_native_optdepends=('pacman: package-owner lookup for pacfile merging')

makedepends=(
  'binutils'
  'curl'
  'flatpak'
  'gettext'
  'git'
  'go-md2man'
  'gtk4'
  'libarchive'
  'pkgconf'
  'sqlite'
  'zig>=0.17.1'
  "${_shelly_native_depends[@]}"
)
checkdepends=('ripgrep')
_srcdir=Shelly-ALPM
source=("${_srcdir}::git+${url}.git#branch=development")
sha256sums=('SKIP')

# Components with their own build.zig, in build order.
_components=(
  Shelly.Flatpak.Backend
  Shelly.Rlpm
  Shelly.PackageManager
  Shelly.Cli.Zig
  Shelly.Key
  Shelly.Tui
  Shelly.Notifications.Zig
  Shelly.Ui.Gtk
)

_zig_build() {
  ZIG_GLOBAL_CACHE_DIR="${srcdir}/zig-global-cache" zig build \
    --cache-dir "${srcdir}/zig-cache" \
    -Dcpu=baseline \
    "$@"
}

