diff --git a/Shelly.Tui/src/views/aur_view.zig b/Shelly.Tui/src/views/aur_view.zig
new file mode 100644
index 00000000..01b44200
--- /dev/null
+++ b/Shelly.Tui/src/views/aur_view.zig
@@ -0,0 +1,250 @@
+const styles = @import("styles.zig");
+const std = @import("std");
+const vaxis = @import("vaxis");
+const vxfw = vaxis.vxfw;
+const Border = @import("border.zig");
+const diagnostics = @import("diagnostics");
+const help_view = @import("help_view.zig");
+const pkgbuild_view = @import("pkgbuild_view.zig");
+const Allocator = std.mem.Allocator;
+const AurPackage = @import("../models/packages.zig").AurPackage;
+const appendDetailList = @import("detail_format.zig").appendDetailList;
+const formatEpoch = @import("detail_format.zig").formatEpoch;
+
+/// Borrows display state and widgets owned by the application.
+/// Query execution and user-action handling remain in Model.
+pub const View = struct {
+    list_percent: u8 = 40,
+    installed_only: bool = false,
+    aur_field: *vxfw.TextField,
+    aur_list: *vxfw.ListView,
+    searching: bool,
+    aur_failed: bool,
+    aur_query: []const u8,
+    result_count: usize,
+    selected: ?*const AurPackage = null,
+    details_scroll: *vxfw.ScrollView,
+    details_active: bool = false,
+    list_active: bool = false,
+    preview: ?pkgbuild_view.View = null,
+    help: ?*help_view.Panel = null,
+    pub fn appendContent(self: View, ctx: vxfw.DrawContext, children: *std.ArrayList(vxfw.SubSurface)) Allocator.Error!void {
+        const arena = ctx.arena;
+        const max = ctx.max.size();
+        if (max.width < 2 or max.height < 3) return;
+        const split = max.width >= 64;
+        const left_w: u16 = if (split) @import("split_layout.zig").listWidth(max.width, self.list_percent) else max.width;
+        const right_w = if (split) max.width - left_w else max.width;
+        const list_width = left_w -| @as(u16, if (split) 1 else 0);
+        const search_height: u16 = if (max.width >= 2 and max.height >= 8) 3 else 1;
+        const list_row = 1 + search_height;
+        const list_height = max.height -| (list_row + 1);
+        const pane_row: u16 = 1;
+        const pane_height = max.height -| (pane_row + 1);
+        const show_pane = split or self.details_active or self.preview != null or self.help != null;
+        if (split or !show_pane) {
+            var search_border: Border = .{ .child = self.aur_field.widget(), .focused = !self.list_active and !self.details_active };
+            try children.append(arena, .{
+                .origin = .{ .row = 1, .col = 0 },
+                .surface = if (search_height == 3)
+                    try search_border.draw(ctx.withConstraints(.{ .width = list_width, .height = search_height }, .{ .width = list_width, .height = search_height }))
+                else
+                    try self.aur_field.draw(ctx.withConstraints(.{}, .{ .width = list_width, .height = search_height })),
+            });
+            const message = try self.aurMessage(arena);
+            var label: vxfw.Text = .{ .text = if (message) |item| item.text else "", .style = if (message != null and message.?.red) .{ .fg = .{ .index = 1 } } else styles.secondary };
+            const labels = [_]Border.BorderLabel{.{ .text = if (self.installed_only) "Installed AUR packages" else "AUR packages", .alignment = .top_left }};
+            const content = if (message != null) label.widget() else self.aur_list.widget();
+            var border: Border = .{ .child = content, .labels = &labels, .focused = self.list_active and !self.details_active };
+            if (list_height > 0) try children.append(arena, .{
+                .origin = .{ .row = @intCast(list_row), .col = 0 },
+                .surface = if (list_width >= 2 and list_height >= 2)
+                    try border.draw(ctx.withConstraints(.{ .width = list_width, .height = list_height }, .{ .width = list_width, .height = list_height }))
+                else
+                    try content.draw(ctx.withConstraints(.{}, .{ .width = list_width, .height = list_height })),
+            });
+        }
+        if (show_pane and pane_height >= 2 and right_w >= 2) {
+            const pane_ctx = ctx.withConstraints(.{}, .{ .width = right_w, .height = pane_height });
+            const surface = if (self.help) |panel|
+                try panel.draw(pane_ctx)
+            else if (self.preview) |preview|
+                try preview.drawInPane(pane_ctx)
+            else blk: {
+                const title = if (self.selected) |pkg| try std.fmt.allocPrint(arena, "{f}", .{diagnostics.safe(pkg.Name)}) else "AUR details";
+                const labels = [_]Border.BorderLabel{.{ .text = title, .alignment = .top_left }};
+                var empty: vxfw.Text = .{ .text = if (self.searching) (if (split) "" else "Waiting for search results…") else "Select a result to see details." };
+                var border: Border = .{
+                    .child = if (self.selected != null and !self.searching) self.details_scroll.widget() else empty.widget(),
+                    .labels = &labels,
+                    .focused = self.details_active,
+                };
+                break :blk try border.draw(pane_ctx.withConstraints(.{ .width = right_w, .height = pane_height }, .{ .width = right_w, .height = pane_height }));
+            };
+            try children.append(arena, .{ .origin = .{ .row = @intCast(pane_row), .col = if (split) @intCast(left_w) else 0 }, .surface = surface });
+        }
+    }
+    fn aurMessage(self: View, arena: Allocator) Allocator.Error!?struct { text: []const u8, red: bool } {
+        if (self.searching and self.installed_only) return .{ .text = "Loading installed AUR packages…", .red = false };
+        if (self.aur_failed and self.installed_only) return .{ .text = "Could not load installed AUR packages.", .red = true };
+        if (self.searching) {
+            return .{
+                .text = try std.fmt.allocPrint(arena, "Searching AUR for '{s}'…", .{self.aur_query}),
+                .red = false,
+            };
+        }
+        if (self.aur_failed) {
+            return .{ .text = "Could not search the configured AUR service.", .red = true };
+        }
+        if (self.installed_only) return if (self.result_count == 0) .{ .text = "No installed AUR packages match the filter.", .red = false } else null;
+        if (self.aur_query.len == 0) {
+            return .{ .text = "Search the AUR to browse packages.", .red = false };
+        }
+        if (self.result_count == 0) {
+            return .{ .text = "No AUR packages matched.", .red = false };
+        }
+        return null;
+    }
+    pub fn statusText(self: View, arena: Allocator) Allocator.Error![]const u8 {
+        if (self.searching and self.installed_only) return "Loading installed AUR packages…";
+        if (self.aur_failed and self.installed_only) return "Installed AUR query failed";
+        if (self.searching) {
+            return try std.fmt.allocPrint(arena, "Searching AUR for '{s}'…", .{self.aur_query});
+        }
+        if (self.aur_failed) return "Could not search the configured AUR service.";
+        if (self.installed_only) return std.fmt.allocPrint(arena, "{d} installed AUR packages", .{self.result_count});
+        if (self.aur_query.len == 0) return "AUR";
+        return try std.fmt.allocPrint(arena, "{d} AUR results for '{s}'", .{
+            self.result_count, self.aur_query,
+        });
+    }
+};
+
+pub fn drawAurRow(ptr: *anyopaque, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+    return drawRow(ptr, ctx, false);
+}
+
+pub fn drawSelectedAurRow(ptr: *anyopaque, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+    return drawRow(ptr, ctx, true);
+}
+
+fn drawRow(ptr: *anyopaque, ctx: vxfw.DrawContext, selected: bool) Allocator.Error!vxfw.Surface {
+    const pkg: *const AurPackage = @ptrCast(@alignCast(ptr));
+    const arena = ctx.arena;
+
+    var spans: std.ArrayList(vxfw.RichText.TextSpan) = .empty;
+    try spans.append(arena, .{ .text = if (selected) "[x] " else "[ ] ", .style = .{ .bold = selected } });
+    try spans.append(arena, .{ .text = if (pkg.Installed) "● " else "  ", .style = .{ .fg = .{ .index = 2 } } });
+    try spans.append(arena, .{ .text = pkg.Name, .style = .{ .bold = true } });
+
+    const rich = try arena.create(vxfw.RichText);
+    rich.* = .{
+        .text = spans.items,
+        .softwrap = false,
+        .overflow = .ellipsis,
+    };
+    const width = ctx.max.width orelse ctx.min.width;
+    return rich.draw(ctx.withConstraints(.{ .width = width }, .{ .width = width, .height = 1 }));
+}
+
+pub fn detailsText(arena: Allocator, pkg: *const AurPackage) Allocator.Error![]const u8 {
+    var lines: std.ArrayList([]const u8) = .empty;
+
+    try lines.append(arena, pkg.Description orelse "No description.");
+    try lines.append(arena, "");
+
+    try lines.append(arena, try std.fmt.allocPrint(arena, "Installed:       {s}", .{if (pkg.Installed) "yes" else "no"}));
+    try lines.append(arena, try std.fmt.allocPrint(arena, "Version:         {s}", .{pkg.Version}));
+    try lines.append(arena, try std.fmt.allocPrint(arena, "Package base:    {s}", .{pkg.PackageBase}));
+    try lines.append(arena, try std.fmt.allocPrint(arena, "Votes:           {d}", .{pkg.NumVotes}));
+    try lines.append(arena, try std.fmt.allocPrint(arena, "Popularity:      {d:.2}", .{pkg.Popularity}));
+    try lines.append(arena, try std.fmt.allocPrint(arena, "Maintainer:      {s}", .{pkg.Maintainer orelse "—"}));
+    try lines.append(arena, try std.fmt.allocPrint(arena, "Out of date:     {s}", .{if (pkg.OutOfDate != null) "yes" else "no"}));
+    if (pkg.Url) |url| {
+        try lines.append(arena, try std.fmt.allocPrint(arena, "URL:             {s}", .{url}));
+    }
+    if (pkg.License) |licenses| try appendDetailList(arena, &lines, "Licenses:     ", licenses);
+    if (pkg.Depends) |depends| try appendDetailList(arena, &lines, "Depends:       ", depends);
+    if (pkg.MakeDepends) |make_depends| try appendDetailList(arena, &lines, "Make deps:     ", make_depends);
+    try lines.append(arena, try std.fmt.allocPrint(arena, "First submitted: {s}", .{try formatEpoch(arena, pkg.FirstSubmitted)}));
+    try lines.append(arena, try std.fmt.allocPrint(arena, "Last modified:   {s}", .{try formatEpoch(arena, pkg.LastModified)}));
+
+    return try std.mem.join(arena, "\n", lines.items);
+}
+
+const detail_fields = @import("detail_fields.zig");
+
+pub fn packageLink(arena: Allocator, pkg: *const AurPackage) Allocator.Error![]const u8 {
+    const base = std.mem.trimEnd(u8, std.mem.trim(u8, pkg.AurBaseUrl, " \t\r\n"), "/");
+    const atoll = if (std.Uri.parse(base)) |uri| if (uri.host) |host| switch (host) {
+        .raw, .percent_encoded => |name| std.ascii.eqlIgnoreCase(name, "atoll.seafoam-labs.org"),
+    } else false else |_| false;
+    var name: std.ArrayList(u8) = .empty;
+    defer name.deinit(arena);
+    const hex = "0123456789ABCDEF";
+    for (pkg.Name) |byte| {
+        if (std.ascii.isAlphanumeric(byte) or std.mem.indexOfScalar(u8, "-._~", byte) != null) try name.append(arena, byte) else try name.appendSlice(arena, &.{ '%', hex[byte >> 4], hex[byte & 15] });
+    }
+    return std.fmt.allocPrint(arena, "{s}/{s}/{s}", .{ base, if (atoll) "package" else "packages", name.items });
+}
+
+pub fn drawDetails(ptr: *anyopaque, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+    const pkg: *const AurPackage = @ptrCast(@alignCast(ptr));
+    const arena = ctx.arena;
+    var fields: std.ArrayList(detail_fields.Field) = .empty;
+    try fields.appendSlice(arena, &.{
+        .{ .label = "Description", .value = pkg.Description orelse "No description." },
+        .{ .label = "Version", .value = pkg.Version, .gap = true },
+        .{ .label = "Installed", .value = if (pkg.Installed) "Yes" else "No" },
+        .{ .label = "Package base", .value = pkg.PackageBase },
+        .{ .label = "Maintainer", .value = pkg.Maintainer orelse "—" },
+        .{ .label = "Votes", .value = try std.fmt.allocPrint(arena, "{d}", .{pkg.NumVotes}) },
+        .{ .label = "Popularity", .value = try std.fmt.allocPrint(arena, "{d:.2}", .{pkg.Popularity}) },
+        .{ .label = "Out of date", .value = if (pkg.OutOfDate != null) "Yes" else "No" },
+    });
+    if (pkg.Url) |url| try fields.append(arena, .{ .label = "URL", .value = url, .preserve_url = true });
+    const page = try packageLink(arena, pkg);
+    try fields.append(arena, .{ .label = if (std.mem.indexOf(u8, page, "/package/") != null) "Atoll page" else "AUR page", .value = page, .preserve_url = true });
+    if (pkg.License) |items| if (items.len > 0) {
+        try fields.append(arena, .{ .label = "Licenses", .value = try std.mem.join(arena, ", ", items) });
+    };
+    try fields.appendSlice(arena, &.{
+        .{ .label = "Submitted", .value = try formatEpoch(arena, pkg.FirstSubmitted), .gap = true },
+        .{ .label = "Modified", .value = try formatEpoch(arena, pkg.LastModified) },
+    });
+    if (pkg.Depends) |items| try detail_fields.listField(arena, &fields, "Dependencies", items);
+    if (pkg.MakeDepends) |items| try detail_fields.listField(arena, &fields, "Make deps", items);
+    return detail_fields.draw(.{ .userdata = ptr, .drawFn = drawDetails }, ctx, fields.items);
+}
+
+// ScrollView supplies unbounded constraints; buttons need a finite viewport.
+pub fn drawPreviewButton(ptr: *anyopaque, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+    const button: *vxfw.Button = @ptrCast(@alignCast(ptr));
+    const viewport = ctx.max.width orelse ctx.min.width;
+    const width: u16 = @intCast(@min(viewport, ctx.stringWidth(button.label)));
+    var surface = try button.draw(ctx.withConstraints(.{ .width = width }, .{ .width = width, .height = 1 }));
+    surface.widget.drawFn = drawPreviewButton;
+    return surface;
+}
+
+test "AUR package pages follow the configured source independently of upstream URLs" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const alloc = arena.allocator();
+    var pkg: AurPackage = .{ .Name = "foot-git", .Url = "https://codeberg.org/dnkl/foot" };
+    try std.testing.expectEqualStrings("https://aur.archlinux.org/packages/foot-git", try packageLink(alloc, &pkg));
+    pkg.AurBaseUrl = "https://atoll.seafoam-labs.org/";
+    try std.testing.expectEqualStrings("https://atoll.seafoam-labs.org/package/foot-git", try packageLink(alloc, &pkg));
+    try std.testing.expectEqualStrings("https://codeberg.org/dnkl/foot", pkg.Url.?);
+    pkg.Name = "name+suffix";
+    try std.testing.expectEqualStrings("https://atoll.seafoam-labs.org/package/name%2Bsuffix", try packageLink(alloc, &pkg));
+    vxfw.DrawContext.init(.unicode);
+    const surface = try drawDetails(&pkg, .{ .arena = alloc, .min = .{ .width = 40 }, .max = .{}, .cell_size = .{ .width = 10, .height = 20 } });
+    var upstream = false;
+    var atoll = false;
+    for (surface.buffer) |cell| {
+        upstream = upstream or std.mem.eql(u8, cell.link.uri, pkg.Url.?);
+        atoll = atoll or std.mem.eql(u8, cell.link.uri, "https://atoll.seafoam-labs.org/package/name%2Bsuffix");
+    }
+    try std.testing.expect(upstream and atoll);
+}
diff --git a/Shelly.Tui/src/views/border.zig b/Shelly.Tui/src/views/border.zig
new file mode 100644
index 00000000..be64fb7a
--- /dev/null
+++ b/Shelly.Tui/src/views/border.zig
@@ -0,0 +1,48 @@
+const styles = @import("styles.zig");
+const std = @import("std");
+const vaxis = @import("vaxis");
+const vxfw = vaxis.vxfw;
+const Border = @This();
+
+pub const BorderLabel = vxfw.Border.BorderLabel;
+
+child: vxfw.Widget,
+style: vaxis.Style = .{},
+focused: bool = false,
+labels: []const BorderLabel = &.{},
+
+pub fn widget(self: *const Border) vxfw.Widget {
+    return .{ .userdata = @constCast(self), .drawFn = drawFn };
+}
+
+fn drawFn(ptr: *anyopaque, ctx: vxfw.DrawContext) std.mem.Allocator.Error!vxfw.Surface {
+    const self: *const Border = @ptrCast(@alignCast(ptr));
+    return self.draw(ctx);
+}
+
+pub fn draw(self: *const Border, ctx: vxfw.DrawContext) std.mem.Allocator.Error!vxfw.Surface {
+    var border: vxfw.Border = .{ .child = self.child, .style = if (self.focused) styles.emphasis else self.style, .labels = self.labels };
+    var surface = try border.draw(ctx);
+    surface.widget = self.widget();
+    // Keep Vaxis sizing, labels and child placement; strengthen only frame cells.
+    if (surface.size.width >= 2 and surface.size.height >= 2) {
+        const width: usize = surface.size.width;
+        const bottom = (surface.size.height - 1) * width;
+        const positions = [_]usize{ 0, width - 1, bottom, bottom + width - 1 };
+        const corners = if (self.focused) [_][]const u8{ "┏", "┓", "┗", "┛" } else [_][]const u8{ "┌", "┐", "└", "┘" };
+        for (positions, corners) |index, corner| surface.buffer[index].char.grapheme = corner;
+        if (self.focused) {
+            for (1..width - 1) |col| {
+                for ([_]usize{ col, bottom + col }) |index| {
+                    if (std.mem.eql(u8, surface.buffer[index].char.grapheme, "─"))
+                        surface.buffer[index].char.grapheme = "━";
+                }
+            }
+            for (1..surface.size.height - 1) |row| {
+                surface.buffer[row * width].char.grapheme = "┃";
+                surface.buffer[row * width + width - 1].char.grapheme = "┃";
+            }
+        }
+    }
+    return surface;
+}
diff --git a/Shelly.Tui/src/views/detail_fields.zig b/Shelly.Tui/src/views/detail_fields.zig
new file mode 100644
index 00000000..7535279f
--- /dev/null
+++ b/Shelly.Tui/src/views/detail_fields.zig
@@ -0,0 +1,131 @@
+const styles = @import("styles.zig");
+const std = @import("std");
+const vaxis = @import("vaxis");
+const vxfw = vaxis.vxfw;
+const diagnostics = @import("diagnostics");
+const Allocator = std.mem.Allocator;
+
+pub const Field = struct {
+    label: []const u8,
+    value: []const u8,
+    gap: bool = false,
+    preserve_url: bool = false,
+};
+
+pub fn listField(arena: Allocator, fields: *std.ArrayList(Field), label: []const u8, items: []const []const u8) Allocator.Error!void {
+    if (items.len == 0) return;
+    try fields.append(arena, .{ .label = label, .value = try std.mem.join(arena, "\n", items), .gap = true });
+}
+
+fn displayValue(arena: Allocator, field: Field) Allocator.Error![]const u8 {
+    if (!field.preserve_url) return std.fmt.allocPrint(arena, "{f}", .{diagnostics.safe(field.value)});
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(arena);
+    const hex = "0123456789abcdef";
+    for (field.value) |byte| {
+        if ((byte < 0x20 and byte != '\n' and byte != '\t') or byte == 0x7f)
+            try out.appendSlice(arena, &.{ '\\', 'x', hex[byte >> 4], hex[byte & 15] })
+        else
+            try out.append(arena, byte);
+    }
+    return out.toOwnedSlice(arena);
+}
+
+fn hyperlink(field: Field) vaxis.Cell.Hyperlink {
+    if (!field.preserve_url) return .{};
+    for (field.value) |byte| if (byte <= 0x20 or byte == 0x7f) return .{};
+    const uri = std.Uri.parse(field.value) catch return .{};
+    if (!std.ascii.eqlIgnoreCase(uri.scheme, "http") and !std.ascii.eqlIgnoreCase(uri.scheme, "https")) return .{};
+    const host = uri.host orelse return .{};
+    if (host.isEmpty()) return .{};
+    return .{ .uri = field.value };
+}
+
+pub fn draw(widget: vxfw.Widget, ctx: vxfw.DrawContext, fields: []const Field) Allocator.Error!vxfw.Surface {
+    const arena = ctx.arena;
+    const width = ctx.max.width orelse ctx.min.width;
+    if (width == 0) return .{ .size = .{ .width = 0, .height = 0 }, .widget = widget, .buffer = &.{}, .children = &.{} };
+    const columns = width >= 36;
+    const label_width: u16 = if (columns) 12 else width;
+    const value_col: u16 = if (columns) 14 else 0;
+    const value_width = width - value_col;
+    var children: std.ArrayList(vxfw.SubSurface) = .empty;
+    var row: u16 = 0;
+    for (fields) |field| {
+        if (field.gap or (!columns and row > 0)) row += 1;
+        var label: vxfw.Text = .{ .text = field.label, .style = styles.emphasis };
+        const label_surface = try label.draw(ctx.withConstraints(.{}, .{ .width = label_width, .height = null }));
+        try children.append(arena, .{ .origin = .{ .row = row, .col = 0 }, .surface = label_surface });
+        const value_row = row + if (columns) @as(u16, 0) else label_surface.size.height;
+        const link = hyperlink(field);
+        const spans = [_]vxfw.RichText.TextSpan{.{
+            .text = try displayValue(arena, field),
+            .link = link,
+            .style = if (link.uri.len > 0) .{ .ul_style = .single } else .{},
+        }};
+        var value: vxfw.RichText = .{ .text = &spans, .softwrap = true };
+        const value_surface = try value.draw(ctx.withConstraints(
+            .{ .width = value_width },
+            .{ .width = value_width, .height = null },
+        ));
+        try children.append(arena, .{ .origin = .{ .row = value_row, .col = value_col }, .surface = value_surface });
+        row = @max(row + label_surface.size.height, value_row + value_surface.size.height);
+    }
+    // Flatten the document into one scrollable surface; no frame-arena Text
+    // widgets need to survive the draw call.
+    const surface = try vxfw.Surface.init(arena, widget, .{ .width = width, .height = row });
+    @memset(surface.buffer, .{});
+    for (children.items) |child| {
+        const origin_row: usize = @intCast(child.origin.row);
+        const origin_col: usize = @intCast(child.origin.col);
+        for (0..child.surface.size.height) |line| {
+            const source = line * child.surface.size.width;
+            const target = (origin_row + line) * width + origin_col;
+            @memcpy(surface.buffer[target .. target + child.surface.size.width], child.surface.buffer[source .. source + child.surface.size.width]);
+        }
+    }
+    return surface;
+}
+
+test "package homepage URLs retain paths and queries while escaping terminal controls" {
+    const url = "https://example.org/project/releases?version=1#details";
+    const literal = try displayValue(std.testing.allocator, .{ .label = "URL", .value = url, .preserve_url = true });
+    defer std.testing.allocator.free(literal);
+    try std.testing.expectEqualStrings(url, literal);
+    const escaped = try displayValue(std.testing.allocator, .{ .label = "URL", .value = "https://example.org/path\x1b[31m", .preserve_url = true });
+    defer std.testing.allocator.free(escaped);
+    try std.testing.expectEqualStrings("https://example.org/path\\x1b[31m", escaped);
+}
+
+test "homepage hyperlinks survive wrapping and flattening without linking labels" {
+    vxfw.DrawContext.init(.unicode);
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var pkg: @import("../models/packages.zig").Package = .{};
+    const url = "https://example.org/project/releases?version=1#details";
+    const surface = try draw(.{ .userdata = &pkg, .drawFn = @import("packages_view.zig").drawDetails }, .{
+        .arena = arena.allocator(),
+        .min = .{},
+        .max = .{ .width = 24, .height = null },
+        .cell_size = .{ .width = 10, .height = 20 },
+    }, &.{.{ .label = "URL", .value = url, .preserve_url = true }});
+    var linked: std.ArrayList(u8) = .empty;
+    defer linked.deinit(std.testing.allocator);
+    var linked_rows: usize = 0;
+    for (0..surface.size.height) |row_index| {
+        var found = false;
+        for (surface.buffer[row_index * 24 .. (row_index + 1) * 24]) |cell| {
+            if (cell.link.uri.len == 0) continue;
+            found = true;
+            try std.testing.expectEqualStrings(url, cell.link.uri);
+            try std.testing.expectEqual(vaxis.Style.Underline.single, cell.style.ul_style);
+            try linked.appendSlice(std.testing.allocator, cell.char.grapheme);
+        }
+        if (found) linked_rows += 1;
+    }
+    try std.testing.expect(linked_rows > 1);
+    try std.testing.expectEqualStrings(url, linked.items);
+    try std.testing.expectEqualStrings("", surface.buffer[0].link.uri);
+    for ([_][]const u8{ "file:///tmp/package", "javascript:alert(1)", "https://example.org/\x1b[31m", "https://example.org/\npath", "https:///" }) |invalid|
+        try std.testing.expectEqualStrings("", hyperlink(.{ .label = "URL", .value = invalid, .preserve_url = true }).uri);
+}
diff --git a/Shelly.Tui/src/views/detail_format.zig b/Shelly.Tui/src/views/detail_format.zig
new file mode 100644
index 00000000..4024fc8c
--- /dev/null
+++ b/Shelly.Tui/src/views/detail_format.zig
@@ -0,0 +1,34 @@
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+pub fn appendDetailList(arena: Allocator, lines: *std.ArrayList([]const u8), comptime label: []const u8, items: []const []const u8) Allocator.Error!void {
+    if (items.len == 0) return;
+    try lines.append(arena, try std.fmt.allocPrint(arena, "{s}{s}", .{
+        label, try std.mem.join(arena, ", ", items),
+    }));
+}
+
+pub fn formatSize(arena: Allocator, bytes: i64) Allocator.Error![]const u8 {
+    if (bytes <= 0) return "—";
+    const units = [_][]const u8{ "B", "KiB", "MiB", "GiB", "TiB" };
+    var value: f64 = @floatFromInt(bytes);
+    var unit: usize = 0;
+    while (value >= 1024.0 and unit < units.len - 1) {
+        value /= 1024.0;
+        unit += 1;
+    }
+    if (unit == 0) return try std.fmt.allocPrint(arena, "{d} B", .{bytes});
+    return try std.fmt.allocPrint(arena, "{d:.1} {s}", .{ value, units[unit] });
+}
+
+pub fn formatEpoch(arena: Allocator, seconds: i64) Allocator.Error![]const u8 {
+    if (seconds <= 0) return "—";
+    const epoch: std.time.epoch.EpochSeconds = .{ .secs = @intCast(seconds) };
+    const year_day = epoch.getEpochDay().calculateYearDay();
+    const month_day = year_day.calculateMonthDay();
+    return try std.fmt.allocPrint(arena, "{d}-{d:0>2}-{d:0>2}", .{
+        year_day.year,
+        month_day.month.numeric(),
+        month_day.day_index + 1,
+    });
+}
diff --git a/Shelly.Tui/src/views/flatpak_view.zig b/Shelly.Tui/src/views/flatpak_view.zig
new file mode 100644
index 00000000..0709b1bc
--- /dev/null
+++ b/Shelly.Tui/src/views/flatpak_view.zig
@@ -0,0 +1,339 @@
+const styles = @import("styles.zig");
+const std = @import("std");
+const Border = @import("border.zig");
+const diagnostics = @import("diagnostics");
+const vxfw = @import("vaxis").vxfw;
+const data = @import("../models/flatpak.zig");
+const Allocator = std.mem.Allocator;
+const formatSize = @import("detail_format.zig").formatSize;
+
+pub const Row = union(enum) {
+    catalog: *const data.AppstreamApp,
+    installed: *const data.Flatpak,
+
+    pub fn matches(self: Row, query: []const u8) bool {
+        return switch (self) {
+            .catalog => |app| contains(app.Id, query) or contains(app.Name, query) or contains(app.Summary, query),
+            .installed => |app| contains(app.Id, query) or contains(app.Name, query) or contains(app.Summary, query) or contains(app.Remote, query),
+        };
+    }
+
+    pub fn sameIdentity(self: Row, other: Row) bool {
+        return switch (self) {
+            .catalog => |app| other == .catalog and std.mem.eql(u8, app.Id, other.catalog.Id),
+            .installed => |app| other == .installed and app.InstallLevel == other.installed.InstallLevel and
+                app.Kind == other.installed.Kind and std.mem.eql(u8, app.Id, other.installed.Id) and
+                std.mem.eql(u8, app.Arch, other.installed.Arch) and std.mem.eql(u8, app.Branch, other.installed.Branch) and
+                std.mem.eql(u8, app.Remote, other.installed.Remote),
+        };
+    }
+
+    pub fn widget(self: Row) vxfw.Widget {
+        return switch (self) {
+            .catalog => |app| .{ .userdata = @constCast(app), .drawFn = drawCatalog },
+            .installed => |app| .{ .userdata = @constCast(app), .drawFn = drawInstalled },
+        };
+    }
+
+    pub fn title(self: Row) []const u8 {
+        return switch (self) {
+            .catalog => |app| app.Id,
+            .installed => |app| app.Id,
+        };
+    }
+
+    pub fn details(self: Row, arena: Allocator) Allocator.Error![]const u8 {
+        return switch (self) {
+            .installed => |app| std.fmt.allocPrint(arena, "{f}\n\nName: {f}\nID: {f}\nVersion: {f}\nScope: {s}\nKind: {s}\nArchitecture: {f}\nBranch: {f}\nRemote: {f}\nRef: {f}\nFull ref: {f}\nInstalled size: {s}", .{ diagnostics.safe(app.Summary), diagnostics.safe(app.Name), diagnostics.safe(app.Id), diagnostics.safe(app.Version), @tagName(app.InstallLevel), @tagName(app.Kind), diagnostics.safe(app.Arch), diagnostics.safe(app.Branch), diagnostics.safe(app.Remote), diagnostics.safe(app.Ref), diagnostics.safe(app.FullRef), try formatSize(arena, app.InstalledSize) }),
+            .catalog => |app| blk: {
+                var remotes: std.ArrayList(u8) = .empty;
+                for (app.Remotes, 0..) |remote, i| {
+                    const text = try std.fmt.allocPrint(arena, "{s}{f} ({s})", .{ if (i == 0) "" else ", ", diagnostics.safe(remote.Name), @tagName(remote.Scope) });
+                    try remotes.appendSlice(arena, text);
+                }
+                break :blk std.fmt.allocPrint(arena, "{f}\n\nName: {f}\nID: {f}\nType: {f}\nDeveloper: {f}\nLicense: {f}\nVerified: {s}\nRemotes: {s}\n\n{f}\n\nCatalog metadata — permissions are not queried.", .{ diagnostics.safe(app.Summary), diagnostics.safe(app.Name), diagnostics.safe(app.Id), diagnostics.safe(app.Type), diagnostics.safe(app.DeveloperName), diagnostics.safe(app.ProjectLicense), if (app.IsVerified) "yes" else "no", remotes.items, diagnostics.safe(app.Description) });
+            },
+        };
+    }
+};
+
+fn contains(text: []const u8, query: []const u8) bool {
+    if (query.len > text.len) return false;
+    for (0..text.len - query.len + 1) |start|
+        if (std.ascii.eqlIgnoreCase(text[start..][0..query.len], query)) return true;
+    return false;
+}
+
+pub const View = struct {
+    list_percent: u8 = 40,
+    images: ?@import("image_view.zig").View = null,
+    category_button: ?*vxfw.Button = null,
+    category_list: ?*vxfw.ListView = null,
+    category_open: bool = false,
+    category: []const u8 = "",
+    field: *vxfw.TextField,
+    list: *vxfw.ListView,
+    installed_only: bool,
+    loading: bool,
+    checking_backend: bool = false,
+    backend_failure: ?anyerror = null,
+    failure: ?anyerror,
+    checked: bool,
+    count: usize,
+    selected: ?Row = null,
+    details_scroll: *vxfw.ScrollView,
+    details_active: bool = false,
+    list_active: bool = false,
+    help: ?*@import("help_view.zig").Panel = null,
+
+    pub fn statusText(self: View, arena: Allocator) Allocator.Error![]const u8 {
+        if (self.checking_backend) return "Checking Flatpak backend…";
+        if (self.backend_failure) |err| return std.fmt.allocPrint(arena, "Flatpak backend check failed: {s}", .{@errorName(err)});
+        if (self.loading) return "Loading Flatpaks…";
+        if (self.failure) |err| return std.fmt.allocPrint(arena, "Flatpak query failed: {s}", .{@errorName(err)});
+        return std.fmt.allocPrint(arena, "{d} {s}", .{ self.count, if (self.installed_only) "installed Flatpaks" else "catalog apps" });
+    }
+
+    pub fn appendContent(self: View, ctx: vxfw.DrawContext, children: *std.ArrayList(vxfw.SubSurface)) Allocator.Error!void {
+        const arena = ctx.arena;
+        const max = ctx.max.size();
+        if (max.width < 2 or max.height < 3) return;
+        const split = max.width >= 64;
+        const left_w: u16 = if (split) @import("split_layout.zig").listWidth(max.width, self.list_percent) else max.width;
+        const right_w = if (split) max.width - left_w else max.width;
+        const list_width = left_w -| @as(u16, if (split) 1 else 0);
+        const search_height: u16 = if (max.width >= 2 and max.height >= 8) 3 else 1;
+        const selector_width: u16 = @min(list_width, 21);
+        const has_selector = self.category_button != null;
+        const side_by_side = !has_selector or list_width >= 33;
+        const search_width = if (has_selector and side_by_side) list_width - selector_width - 1 else list_width;
+        const search_row: u16 = if (side_by_side) 1 else 1 + search_height;
+        const list_row = 1 + search_height + @as(u16, if (side_by_side) 0 else search_height);
+        const list_height = max.height -| (list_row + 1);
+        const pane_row: u16 = 1;
+        const pane_height = max.height -| (pane_row + 1);
+        const show_pane = split or (!self.category_open and self.details_active) or self.help != null;
+        if (split or !show_pane) {
+            var search_border: Border = .{ .child = self.field.widget(), .focused = !self.list_active and !self.details_active };
+            try children.append(arena, .{
+                .origin = .{ .row = @intCast(search_row), .col = 0 },
+                .surface = if (search_height == 3)
+                    try search_border.draw(ctx.withConstraints(.{ .width = search_width, .height = search_height }, .{ .width = search_width, .height = search_height }))
+                else
+                    try self.field.draw(ctx.withConstraints(.{}, .{ .width = search_width, .height = search_height })),
+            });
+            if (self.category_button) |button| {
+                button.label = try std.fmt.allocPrint(arena, "{f} ▾", .{diagnostics.safe(if (self.category.len == 0) "All categories" else self.category)});
+                var border: Border = .{ .child = categoryButtonWidget(button) };
+                const selector_ctx = ctx.withConstraints(.{ .width = selector_width, .height = search_height }, .{ .width = selector_width, .height = search_height });
+                try children.append(arena, .{ .origin = .{ .row = 1, .col = if (side_by_side) @intCast(search_width + 1) else 0 }, .surface = if (search_height == 3) try border.draw(selector_ctx) else try categoryButtonWidget(button).draw(selector_ctx) });
+            }
+            const message = self.contentMessage();
+            var label: vxfw.Text = .{ .text = message orelse "", .style = styles.secondary };
+            const labels = [_]Border.BorderLabel{.{ .text = if (self.installed_only) "Installed Flatpaks" else "Flatpak applications", .alignment = .top_left }};
+            const content = if (message != null) label.widget() else self.list.widget();
+            var border: Border = .{ .child = content, .labels = &labels, .focused = self.list_active and !self.details_active };
+            if (list_height > 0) try children.append(arena, .{
+                .origin = .{ .row = @intCast(list_row), .col = 0 },
+                .surface = if (list_width >= 2 and list_height >= 2)
+                    try border.draw(ctx.withConstraints(.{ .width = list_width, .height = list_height }, .{ .width = list_width, .height = list_height }))
+                else
+                    try content.draw(ctx.withConstraints(.{}, .{ .width = list_width, .height = list_height })),
+            });
+        }
+        if (show_pane and pane_height >= 2 and right_w >= 2) {
+            const pane_ctx = ctx.withConstraints(.{}, .{ .width = right_w, .height = pane_height });
+            const surface = if (self.help) |panel|
+                try panel.draw(pane_ctx)
+            else blk: {
+                const title = if (self.selected) |pkg| try std.fmt.allocPrint(arena, "{f}", .{diagnostics.safe(switch (pkg) {
+                    .catalog => |app| if (app.Name.len > 0) app.Name else app.Id,
+                    .installed => |app| if (app.Name.len > 0) app.Name else app.Id,
+                })}) else "Flatpak details";
+                const labels = [_]Border.BorderLabel{.{ .text = title, .alignment = .top_left }};
+                var empty: vxfw.Text = .{ .text = if (self.loading) (if (split) "" else "Loading Flatpaks…") else "Select a result to see details." };
+                const details = try arena.create(DetailsBody);
+                details.* = .{ .scroll = self.details_scroll, .images = self.images };
+                var border: Border = .{
+                    .child = if (self.selected != null and !self.loading) details.widget() else empty.widget(),
+                    .labels = &labels,
+                    .focused = self.details_active,
+                };
+                break :blk try border.draw(pane_ctx.withConstraints(.{ .width = right_w, .height = pane_height }, .{ .width = right_w, .height = pane_height }));
+            };
+            try children.append(arena, .{ .origin = .{ .row = @intCast(pane_row), .col = if (split) @intCast(left_w) else 0 }, .surface = surface });
+        }
+        if (self.category_open and self.category_list != null and self.help == null) {
+            const popup_height = @min(@as(u16, 14), max.height -| (1 + search_height + 1));
+            if (popup_height >= 3 and list_width >= 3) {
+                const labels = [_]Border.BorderLabel{.{ .text = "Categories", .alignment = .top_left }};
+                var menu: Border = .{ .child = self.category_list.?.widget(), .labels = &labels };
+                try children.append(arena, .{ .origin = .{ .row = @intCast(1 + search_height), .col = 0 }, .z_index = 3, .surface = try menu.draw(ctx.withConstraints(.{ .width = list_width, .height = popup_height }, .{ .width = list_width, .height = popup_height })) });
+            }
+        }
+    }
+    fn contentMessage(self: View) ?[]const u8 {
+        return if (self.checking_backend) "Checking Flatpak backend…" else if (self.backend_failure != null) "Flatpak is enabled, but its backend could not be used. Install the Shelly Flatpak backend to use this source." else if (self.loading) "Loading Flatpaks…" else if (self.failure != null) "Could not load Flatpaks." else if (!self.checked) "Flatpak list not loaded yet." else if (self.count == 0) "No Flatpaks match. Catalogs reflect configured remotes and cached metadata." else null;
+    }
+};
+
+fn drawCatalog(ptr: *anyopaque, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+    const app: *const data.AppstreamApp = @ptrCast(@alignCast(ptr));
+    const spans = [_]vxfw.RichText.TextSpan{
+        .{ .text = if (app.Installed) "● " else "  ", .style = .{ .fg = .{ .index = 2 } } },
+        .{ .text = try std.fmt.allocPrint(ctx.arena, "{f}", .{diagnostics.safe(if (app.Name.len > 0) app.Name else app.Id)}), .style = .{ .bold = true } },
+    };
+    var label: vxfw.RichText = .{ .text = &spans, .softwrap = false, .overflow = .ellipsis };
+    return label.draw(ctx);
+}
+
+fn drawInstalled(ptr: *anyopaque, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+    const app: *const data.Flatpak = @ptrCast(@alignCast(ptr));
+    const spans = [_]vxfw.RichText.TextSpan{
+        .{ .text = "● ", .style = .{ .fg = .{ .index = 2 } } },
+        .{ .text = try std.fmt.allocPrint(ctx.arena, "{f} ({s})", .{ diagnostics.safe(if (app.Name.len > 0) app.Name else app.Id), @tagName(app.InstallLevel) }), .style = .{ .bold = true } },
+    };
+    var label: vxfw.RichText = .{ .text = &spans, .softwrap = false, .overflow = .ellipsis };
+    return label.draw(ctx);
+}
+
+/// The source step occupies the same reserved bottom area as authentication.
+pub fn drawInstallChoices(ctx: vxfw.DrawContext, app: *const data.AppstreamApp, selected: usize) Allocator.Error!vxfw.Surface {
+    const size = ctx.max.size();
+    const framed = size.width >= 2 and size.height >= 3;
+    const inner_height = size.height -| @as(u16, if (framed) 2 else 0);
+    var lines: std.ArrayList(u8) = .empty;
+    if (inner_height >= 3) try lines.appendSlice(ctx.arena, "Choose a remote and installation scope.\n\n");
+    const capacity = @max(@as(usize, 1), inner_height -| @as(u16, if (inner_height >= 3) 2 else 0));
+    const start = @min(selected -| (capacity / 2), app.Remotes.len -| capacity);
+    for (start..@min(app.Remotes.len, start + capacity)) |index| {
+        const remote = app.Remotes[index];
+        try lines.appendSlice(ctx.arena, try std.fmt.allocPrint(ctx.arena, "{s} {f} ({s})\n", .{ if (index == selected) ">" else " ", diagnostics.safe(remote.Name), @tagName(remote.Scope) }));
+    }
+    var text: vxfw.Text = .{ .text = lines.items, .softwrap = false, .overflow = .ellipsis };
+    if (!framed) return text.draw(ctx);
+    const labels = [_]Border.BorderLabel{.{ .text = try std.fmt.allocPrint(ctx.arena, "Install {f} — Remote", .{diagnostics.safe(app.Id)}), .alignment = .top_left }};
+    var border: Border = .{ .child = text.widget(), .labels = &labels };
+    return border.draw(ctx.withConstraints(size, .{ .width = size.width, .height = size.height }));
+}
+
+const detail_fields = @import("detail_fields.zig");
+pub fn drawDetails(ptr: *anyopaque, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+    const row: *const Row = @ptrCast(@alignCast(ptr));
+    const arena = ctx.arena;
+    var fields: std.ArrayList(detail_fields.Field) = .empty;
+    switch (row.*) {
+        .installed => |app| try fields.appendSlice(arena, &.{
+            .{ .label = "Description", .value = app.Summary },
+            .{ .label = "Name", .value = app.Name, .gap = true },
+            .{ .label = "ID", .value = app.Id },
+            .{ .label = "Version", .value = app.Version },
+            .{ .label = "Scope", .value = @tagName(app.InstallLevel) },
+            .{ .label = "Kind", .value = @tagName(app.Kind) },
+            .{ .label = "Architecture", .value = app.Arch },
+            .{ .label = "Branch", .value = app.Branch },
+            .{ .label = "Remote", .value = app.Remote },
+            .{ .label = "Ref", .value = app.Ref },
+            .{ .label = "Full ref", .value = app.FullRef },
+            .{ .label = "Size", .value = try formatSize(arena, app.InstalledSize) },
+        }),
+        .catalog => |app| {
+            try fields.appendSlice(arena, &.{
+                .{ .label = "Summary", .value = app.Summary },
+                .{ .label = "Description", .value = app.Description, .gap = true },
+                .{ .label = "Name", .value = app.Name, .gap = true },
+                .{ .label = "ID", .value = app.Id },
+                .{ .label = "Installed", .value = if (app.Installed) "Yes" else "No" },
+                .{ .label = "Type", .value = app.Type },
+                .{ .label = "Developer", .value = app.DeveloperName },
+                .{ .label = "License", .value = app.ProjectLicense },
+                .{ .label = "Verified", .value = if (app.IsVerified) "Yes" else "No" },
+            });
+            try detail_fields.listField(arena, &fields, "Categories", app.Categories);
+            for (app.Remotes, 0..) |remote, i| try fields.append(arena, .{ .label = if (i == 0) "Remotes" else "", .value = try std.fmt.allocPrint(arena, "{s} ({s})", .{ remote.Name, @tagName(remote.Scope) }) });
+        },
+    }
+    return detail_fields.draw(.{ .userdata = ptr, .drawFn = drawDetails }, ctx, fields.items);
+}
+
+/// Borrows catalog category names. Model owns the options and handles selection.
+pub const CategoryOption = struct {
+    name: []const u8,
+    userdata: *anyopaque,
+    onSelect: *const fn (*anyopaque, *vxfw.EventContext, []const u8) anyerror!void,
+
+    pub fn widget(self: *const CategoryOption) vxfw.Widget {
+        return .{ .userdata = @constCast(self), .drawFn = draw, .eventHandler = event };
+    }
+    fn draw(ptr: *anyopaque, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+        const self: *const CategoryOption = @ptrCast(@alignCast(ptr));
+        var text: vxfw.Text = .{ .text = try std.fmt.allocPrint(ctx.arena, "{f}", .{diagnostics.safe(if (self.name.len == 0) "All categories" else self.name)}), .softwrap = false, .overflow = .ellipsis };
+        var surface = try text.draw(ctx.withConstraints(.{}, .{ .width = ctx.max.width orelse ctx.min.width, .height = 1 }));
+        surface.widget = self.widget();
+        return surface;
+    }
+    fn event(ptr: *anyopaque, ctx: *vxfw.EventContext, value: vxfw.Event) anyerror!void {
+        if (value != .mouse or value.mouse.type != .press or value.mouse.button != .left) return;
+        const self: *const CategoryOption = @ptrCast(@alignCast(ptr));
+        try self.onSelect(self.userdata, ctx, self.name);
+        return ctx.consumeAndRedraw();
+    }
+};
+
+fn categoryButtonWidget(button: *vxfw.Button) vxfw.Widget {
+    return .{ .userdata = button, .drawFn = drawCategoryButton, .eventHandler = categoryButtonEvent };
+}
+fn drawCategoryButton(ptr: *anyopaque, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+    const button: *vxfw.Button = @ptrCast(@alignCast(ptr));
+    var surface = try button.draw(ctx);
+    surface.widget = categoryButtonWidget(button);
+    return surface;
+}
+fn categoryButtonEvent(ptr: *anyopaque, ctx: *vxfw.EventContext, event: vxfw.Event) anyerror!void {
+    const button: *vxfw.Button = @ptrCast(@alignCast(ptr));
+    const consumed = ctx.consume_event;
+    try button.handleEvent(ctx, event);
+    if (event == .mouse_enter) ctx.consume_event = consumed;
+}
+
+/// Screenshots stay fixed while metadata scrolls independently below them.
+const DetailsBody = struct {
+    scroll: *vxfw.ScrollView,
+    images: ?@import("image_view.zig").View,
+    fn widget(self: *DetailsBody) vxfw.Widget {
+        return .{ .userdata = self, .drawFn = draw };
+    }
+    fn draw(ptr: *anyopaque, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+        const self: *DetailsBody = @ptrCast(@alignCast(ptr));
+        const size = ctx.max.size();
+        const image_height: u16 = if (self.images != null and @import("split_layout.zig").imagesFit(size.width, size.height)) @max(4, size.height / 2) else 0;
+        const details_row = if (image_height > 0) image_height + 1 else 0;
+        var children: std.ArrayList(vxfw.SubSurface) = .empty;
+        if (image_height > 0) try children.append(ctx.arena, .{ .origin = .{ .row = 0, .col = 0 }, .surface = try self.images.?.draw(ctx.withConstraints(.{}, .{ .width = size.width, .height = image_height })) });
+        try children.append(ctx.arena, .{ .origin = .{ .row = @intCast(details_row), .col = 0 }, .surface = try self.scroll.draw(ctx.withConstraints(.{}, .{ .width = size.width, .height = size.height - details_row })) });
+        return .{ .size = size, .widget = self.widget(), .buffer = &.{}, .children = children.items };
+    }
+};
+
+test "reserved source panel keeps the chosen remote visible with many remotes" {
+    vxfw.DrawContext.init(.unicode);
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var remotes: [20]data.Remote = @splat(.{ .Name = "other", .Scope = .system });
+    remotes[19].Name = "last-selected";
+    const app: data.AppstreamApp = .{ .Id = "org.example.Editor", .Remotes = &remotes };
+    const Collect = struct {
+        fn text(alloc: Allocator, output: *std.ArrayList(u8), surface: vxfw.Surface) Allocator.Error!void {
+            for (surface.buffer) |cell| try output.appendSlice(alloc, cell.char.grapheme);
+            for (surface.children) |child| try text(alloc, output, child.surface);
+        }
+    };
+    for ([_]u16{ 3, 4, 8 }) |height| {
+        const surface = try drawInstallChoices(.{ .arena = arena.allocator(), .min = .{}, .max = .{ .width = 80, .height = height }, .cell_size = .{ .width = 10, .height = 20 } }, &app, 19);
+        try std.testing.expectEqual(@as(u16, 80), surface.size.width);
+        try std.testing.expectEqual(height, surface.size.height);
+        var output: std.ArrayList(u8) = .empty;
+        try Collect.text(arena.allocator(), &output, surface);
+        try std.testing.expect(std.mem.indexOf(u8, output.items, "> last-selected (system)") != null);
+    }
+}
diff --git a/Shelly.Tui/src/views/footer_view.zig b/Shelly.Tui/src/views/footer_view.zig
new file mode 100644
index 00000000..da912279
--- /dev/null
+++ b/Shelly.Tui/src/views/footer_view.zig
@@ -0,0 +1,84 @@
+const styles = @import("styles.zig");
+const std = @import("std");
+const vaxis = @import("vaxis");
+const vxfw = vaxis.vxfw;
+const commands = @import("../commands.zig");
+const Allocator = std.mem.Allocator;
+
+/// Render current key labels rather than embedding shortcuts in status strings.
+pub fn draw(ctx: vxfw.DrawContext, context: commands.Context, status: ?[]const u8) Allocator.Error!vxfw.Surface {
+    const size = ctx.max.size();
+    const help_label = try std.fmt.allocPrint(ctx.arena, "{s} {s}", .{ try commands.label(ctx.arena, .help), if (context.mode == .help) "Back" else "Help" });
+    const help_width: u16 = @intCast(@min(size.width, ctx.stringWidth(help_label)));
+    const main_width = size.width -| (help_width + 2);
+    var spans: std.ArrayList(vxfw.RichText.TextSpan) = .empty;
+    var used: usize = 0;
+    const prefix = status orelse if (context.selected_count > 0)
+        try std.fmt.allocPrint(ctx.arena, "{d} selected · {d} installed · {d} available  ", .{ context.selected_count, context.selected_installed, context.selected_count - context.selected_installed })
+    else
+        "";
+    if (prefix.len > 0) {
+        try spans.append(ctx.arena, .{ .text = prefix, .style = styles.secondary });
+        used = ctx.stringWidth(prefix);
+    }
+    for (try commands.entries(ctx.arena, context)) |entry| {
+        // Resizing stays discoverable in F1 help without crowding the footer.
+        if (entry.id == .narrow_view or entry.id == .widen_view) continue;
+        if ((entry.id == .mark and context.mode != .answers) or (context.mode == .search and (entry.id == .install or entry.id == .remove))) continue;
+        if (entry.id == .next) continue;
+        if (entry.id == .save_settings and context.mode == .settings and context.settings_save_selected) continue;
+        // Keep alternative bindings in F1 help instead of repeating actions.
+        if (entry.id == .close and (context.mode == .review or context.mode == .result or context.mode == .confirmation)) continue;
+        const key = if (entry.id == .previous)
+            try std.fmt.allocPrint(ctx.arena, "{s}/{s}", .{ try commands.label(ctx.arena, .previous), try commands.label(ctx.arena, .next) })
+        else
+            try commands.label(ctx.arena, entry.id);
+        const short = if (entry.id == .previous) switch (context.mode) {
+            .search, .packages, .aur, .flatpak => "Browse",
+            .settings, .choice, .answers => "Select",
+            else => "Scroll",
+        } else entry.short;
+        const description = try std.fmt.allocPrint(ctx.arena, " {s}  ", .{short});
+        const width = ctx.stringWidth(key) + ctx.stringWidth(description);
+        if (used + width > main_width) continue;
+        try spans.append(ctx.arena, .{ .text = key, .style = styles.emphasis });
+        try spans.append(ctx.arena, .{ .text = description, .style = styles.secondary });
+        used += width;
+    }
+    const quit = try commands.label(ctx.arena, .quit);
+    const quit_description = " Quit";
+    if (!context.quit_blocked and used + ctx.stringWidth(quit) + ctx.stringWidth(quit_description) <= main_width) {
+        try spans.append(ctx.arena, .{ .text = quit, .style = styles.emphasis });
+        try spans.append(ctx.arena, .{ .text = quit_description, .style = styles.secondary });
+    }
+    var main: vxfw.RichText = .{ .text = spans.items, .softwrap = false, .overflow = .ellipsis };
+    var help: vxfw.Text = .{ .text = help_label, .softwrap = false, .style = styles.emphasis };
+    const children = try ctx.arena.alloc(vxfw.SubSurface, 2);
+    children[0] = .{ .origin = .{ .row = 0, .col = 0 }, .surface = try main.draw(ctx.withConstraints(.{}, .{ .width = main_width, .height = 1 })) };
+    children[1] = .{ .origin = .{ .row = 0, .col = @intCast(size.width - help_width) }, .surface = try help.draw(ctx.withConstraints(.{}, .{ .width = help_width, .height = 1 })) };
+    return .{ .size = size, .widget = help.widget(), .buffer = &.{}, .children = children };
+}
+
+test "footer reflects operation context and live wrapping state" {
+    vxfw.DrawContext.init(.unicode);
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const contexts = [_]commands.Context{
+        .{ .mode = .preview_document, .source_wrap = true },
+        .{ .mode = .preview_document, .source_wrap = false },
+        .{ .mode = .authentication },
+        .{ .mode = .answers, .multiple_choices = true },
+        .{ .mode = .review },
+        .{ .mode = .running },
+        .{ .mode = .running, .quit_blocked = true },
+    };
+    for (contexts, [_][]const u8{ "Unwrap", "Wrap", "Run", "Toggle", "Approve", "Quit", "Help" }) |context, expected| {
+        const surface = try draw(.{ .arena = arena.allocator(), .min = .{}, .max = .{ .width = 140, .height = 1 }, .cell_size = .{ .width = 10, .height = 20 } }, context, null);
+        var text: std.ArrayList(u8) = .empty;
+        for (surface.children) |child| for (child.surface.buffer) |cell| try text.appendSlice(arena.allocator(), cell.char.grapheme);
+        try std.testing.expect(std.mem.indexOf(u8, text.items, expected) != null);
+        try std.testing.expect(std.mem.indexOf(u8, text.items, "F1 Help") != null);
+        if (context.quit_blocked) try std.testing.expect(std.mem.indexOf(u8, text.items, "Quit") == null);
+        if (context.mode == .review) try std.testing.expectEqual(@as(usize, 1), std.mem.count(u8, text.items, "Decline"));
+    }
+}
diff --git a/Shelly.Tui/src/views/help_view.zig b/Shelly.Tui/src/views/help_view.zig
new file mode 100644
index 00000000..6cc486a1
--- /dev/null
+++ b/Shelly.Tui/src/views/help_view.zig
@@ -0,0 +1,124 @@
+const styles = @import("styles.zig");
+const std = @import("std");
+const vaxis = @import("vaxis");
+const vxfw = vaxis.vxfw;
+const commands = @import("../commands.zig");
+const Border = @import("border.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Panel = struct {
+    context: commands.Context = .{},
+    scroll: vxfw.ScrollView = .{ .children = .{ .slice = &.{} } },
+    initialized: bool = false,
+
+    pub fn handleKey(self: *Panel, ctx: *vxfw.EventContext, key: vaxis.Key) !void {
+        if (commands.scrollKey(key)) |canonical| try self.scroll.handleEvent(ctx, .{ .key_press = canonical });
+    }
+
+    pub fn draw(self: *Panel, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+        if (!self.initialized) {
+            self.scroll = .{ .item_count = 1, .children = .{ .builder = .{ .userdata = self, .buildFn = buildBody } } };
+            self.initialized = true;
+        }
+        const size = ctx.max.size();
+        if (size.width < 2 or size.height < 2) {
+            var tiny: vxfw.Text = .{ .text = "Help" };
+            return tiny.draw(ctx);
+        }
+        const labels = [_]Border.BorderLabel{.{ .text = "Help", .alignment = .top_left }};
+        var border: Border = .{ .child = self.scroll.widget(), .labels = &labels, .style = styles.emphasis };
+        return border.draw(ctx.withConstraints(size, .{ .width = size.width, .height = size.height }));
+    }
+
+    fn buildBody(ptr: *const anyopaque, index: usize, _: usize) ?vxfw.Widget {
+        if (index != 0) return null;
+        return .{ .userdata = @constCast(ptr), .drawFn = drawBody };
+    }
+
+    pub fn text(self: *const Panel, arena: Allocator) Allocator.Error![]const u8 {
+        var lines: std.ArrayList([]const u8) = .empty;
+        const heading: []const u8 = switch (self.context.mode) {
+            .search => "Packages browsing",
+            .packages => "Packages list",
+            .details => "Package details",
+            .aur => "AUR browsing",
+            .flatpak => "Flatpak browsing",
+            .updates => "Updates",
+            .settings => "Settings",
+            .authentication => "Authentication",
+            .confirmation => "Confirmation",
+            .running => "Operation progress",
+            .result => "Operation result",
+            .review => "Operation review",
+            .preview_document => "PKGBUILD preview",
+            .answers => "Operation choices",
+            .choice => if (self.context.category_choice) "Flatpak categories" else "Remote and scope",
+            .help => "Help",
+        };
+        try lines.appendSlice(arena, &.{ heading, "" });
+        switch (self.context.mode) {
+            .search, .packages, .aur, .flatpak, .details => {
+                try lines.appendSlice(arena, &.{
+                    "Vim navigation",
+                    "Esc: Leave search and focus the package list",
+                    "j / k: Next / previous package, or scroll details down / up",
+                    "l: Open details from the package list",
+                    "h: Return from details to the package list",
+                    "/: Return to search",
+                    "While editing search, h/j/k/l remain ordinary text.",
+                    "",
+                });
+            },
+            else => {},
+        }
+        if (self.context.mode == .running) try lines.append(arena, "The operation continues while help is open.");
+        for (try commands.entries(arena, self.context)) |entry| {
+            try lines.append(arena, try std.fmt.allocPrint(arena, "{s}: {s}", .{ try commands.label(arena, entry.id), entry.description }));
+        }
+        if (self.context.mode == .search) try lines.append(arena, "While editing search, letters and Left/Right edit the text.");
+        if (self.context.mode == .authentication) try lines.append(arena, "Enter starts sudo authentication in a private terminal. No password is collected before starting.");
+        if (self.context.authenticating) try lines.append(arena, "Follow sudo's password or fingerprint prompt. Password input is not echoed. Ctrl+c or Ctrl+q interrupts authentication; Backspace and Ctrl+u edit input.");
+        try lines.appendSlice(arena, &.{ "", "Application", "" });
+        const globals = [_]struct { id: commands.Id, description: []const u8 }{
+            .{ .id = .help, .description = "Open/close help; return to the previous focus" },
+            .{ .id = .next_tab, .description = "Next enabled page (while browsing)" },
+            .{ .id = .previous_tab, .description = "Previous enabled page (while browsing)" },
+            .{ .id = .quit, .description = "Quit the application" },
+        };
+        for (globals) |entry| {
+            if (self.context.quit_blocked and (entry.id == .quit or entry.id == .interrupt)) continue;
+            try lines.append(arena, try std.fmt.allocPrint(arena, "{s}: {s}", .{ try commands.label(arena, entry.id), entry.description }));
+        }
+        if (self.context.quit_blocked) try lines.append(arena, "Quitting is disabled until the package operation finishes.");
+        if (self.context.tab_count > 0) try lines.append(arena, try std.fmt.allocPrint(arena, "Alt+1…Alt+{d}: Select an enabled page (while browsing)", .{self.context.tab_count}));
+        return std.mem.join(arena, "\n", lines.items);
+    }
+
+    fn drawBody(ptr: *anyopaque, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+        const self: *const Panel = @ptrCast(@alignCast(ptr));
+        const width = ctx.max.width orelse ctx.min.width;
+        var spans: std.ArrayList(vxfw.RichText.TextSpan) = .empty;
+        var lines = std.mem.splitScalar(u8, try self.text(ctx.arena), '\n');
+        while (lines.next()) |line| {
+            if (std.mem.indexOf(u8, line, ": ")) |separator| {
+                try spans.append(ctx.arena, .{ .text = line[0 .. separator + 1], .style = styles.emphasis });
+                try spans.append(ctx.arena, .{ .text = line[separator + 1 ..], .style = styles.secondary });
+            } else try spans.append(ctx.arena, .{ .text = line, .style = styles.emphasis });
+            try spans.append(ctx.arena, .{ .text = "\n" });
+        }
+        var rich: vxfw.RichText = .{ .text = spans.items, .softwrap = true };
+        return rich.draw(ctx.withConstraints(.{ .width = width }, .{ .width = width, .height = null }));
+    }
+};
+
+test "browsing help explicitly lists Vim aliases and search escape" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    for ([_]commands.Mode{ .search, .packages, .aur, .flatpak, .details }) |mode| {
+        const panel: Panel = .{ .context = .{ .mode = mode } };
+        const body = try panel.text(arena.allocator());
+        for ([_][]const u8{ "Esc:", "j / k:", "l:", "h:", "remain ordinary text" }) |expected| {
+            try std.testing.expect(std.mem.indexOf(u8, body, expected) != null);
+        }
+    }
+}
diff --git a/Shelly.Tui/src/views/image_view.zig b/Shelly.Tui/src/views/image_view.zig
new file mode 100644
index 00000000..40c8cbaa
--- /dev/null
+++ b/Shelly.Tui/src/views/image_view.zig
@@ -0,0 +1,131 @@
+const std = @import("std");
+const vaxis = @import("vaxis");
+const vxfw = vaxis.vxfw;
+const diagnostics = @import("diagnostics");
+
+pub const View = struct {
+    previous: ?*vxfw.Button = null,
+    next: ?*vxfw.Button = null,
+    index: usize,
+    count: usize,
+    caption: []const u8,
+    image: ?vaxis.Image = null,
+    failure: ?anyerror = null,
+
+    pub fn draw(self: View, ctx: vxfw.DrawContext) std.mem.Allocator.Error!vxfw.Surface {
+        const body = try ctx.arena.create(View);
+        body.* = self;
+        const size = ctx.max.size();
+        if (size.height < 2 or size.width < 8) return drawBody(body, ctx);
+        var children: std.ArrayList(vxfw.SubSurface) = .empty;
+        const controls = self.count > 1 and self.previous != null and self.next != null and size.width >= 16;
+        const control_width: u16 = if (controls) 8 else 0;
+        var heading: vxfw.Text = .{ .text = try std.fmt.allocPrint(ctx.arena, "Screenshot {d}/{d}", .{ self.index + 1, self.count }), .softwrap = false, .overflow = .ellipsis, .style = .{ .bold = true } };
+        try children.append(ctx.arena, .{ .origin = .{ .row = 0, .col = 0 }, .surface = try heading.draw(ctx.withConstraints(.{}, .{ .width = size.width - control_width, .height = 1 })) });
+        if (controls) {
+            try children.append(ctx.arena, .{ .origin = .{ .row = 0, .col = @intCast(size.width - 7) }, .surface = try buttonWidget(self.previous.?).draw(ctx.withConstraints(.{}, .{ .width = 3, .height = 1 })) });
+            try children.append(ctx.arena, .{ .origin = .{ .row = 0, .col = @intCast(size.width - 3) }, .surface = try buttonWidget(self.next.?).draw(ctx.withConstraints(.{}, .{ .width = 3, .height = 1 })) });
+        }
+        try children.append(ctx.arena, .{ .origin = .{ .row = 1, .col = 0 }, .surface = try drawBody(body, ctx.withConstraints(.{}, .{ .width = size.width, .height = size.height - 1 })) });
+        return .{ .size = size, .widget = .{ .userdata = body, .drawFn = drawBody }, .buffer = &.{}, .children = children.items };
+    }
+    fn drawBody(ptr: *anyopaque, ctx: vxfw.DrawContext) std.mem.Allocator.Error!vxfw.Surface {
+        const self: *const View = @ptrCast(@alignCast(ptr));
+        const size = ctx.max.size();
+        var surface = try vxfw.Surface.init(ctx.arena, .{ .userdata = ptr, .drawFn = drawBody }, size);
+        @memset(surface.buffer, .{});
+        var caption: vxfw.Text = .{ .text = try std.fmt.allocPrint(ctx.arena, "{f}", .{diagnostics.safe(self.caption)}), .softwrap = false, .overflow = .ellipsis };
+        const children = try ctx.arena.alloc(vxfw.SubSurface, 1);
+        children[0] = .{ .origin = .{ .row = 0, .col = 0 }, .surface = try caption.draw(ctx.withConstraints(.{}, .{ .width = size.width, .height = 1 })) };
+        const caption_height: u16 = if (self.caption.len > 0) 1 else 0;
+        surface.children = if (caption_height > 0) children else &.{};
+        if (size.height <= caption_height or size.width == 0) return surface;
+        if (self.image) |img| {
+            const cell_w = @max(@as(u16, 1), ctx.cell_size.width);
+            const cell_h = @max(@as(u16, 1), ctx.cell_size.height);
+            const max_w: u64 = @as(u64, size.width) * cell_w;
+            const max_h: u64 = @as(u64, size.height - caption_height) * cell_h;
+            var cols: u16 = size.width;
+            var rows: u16 = size.height - caption_height;
+            if (max_w * img.height > max_h * img.width) cols = @intCast(@max(1, @min(size.width, max_h * img.width / img.height / cell_w))) else rows = @intCast(@max(1, @min(size.height - caption_height, max_w * img.height / img.width / cell_h)));
+            const row = caption_height + (size.height - caption_height - rows) / 2;
+            const col = (size.width - cols) / 2;
+            surface.buffer[@as(usize, row) * size.width + col].image = .{ .img_id = img.imageId(), .options = .{ .size = .{ .rows = rows, .cols = cols } } };
+        } else {
+            var message: vxfw.Text = .{ .text = if (self.failure) |err| try std.fmt.allocPrint(ctx.arena, "Could not load screenshot: {s}", .{@errorName(err)}) else "Loading screenshot…" };
+            const extra = try ctx.arena.alloc(vxfw.SubSurface, 1 + caption_height);
+            if (caption_height > 0) extra[0] = children[0];
+            extra[caption_height] = .{ .origin = .{ .row = @intCast(caption_height), .col = 0 }, .surface = try message.draw(ctx.withConstraints(.{}, .{ .width = size.width, .height = size.height - caption_height })) };
+            surface.children = extra;
+        }
+        return surface;
+    }
+};
+
+test "screenshot placement fits its pane on resize and preserves caption" {
+    vxfw.DrawContext.init(.unicode);
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const view: View = .{ .index = 1, .count = 3, .caption = "Application window", .image = vaxis.Image.init(42, 1920, 1080) };
+    for ([_]vxfw.Size{ .{ .width = 60, .height = 20 }, .{ .width = 20, .height = 8 }, .{ .width = 2, .height = 2 } }) |size| {
+        const ctx: vxfw.DrawContext = .{ .arena = arena.allocator(), .min = .{}, .max = .{ .width = size.width, .height = size.height }, .cell_size = .{ .width = 10, .height = 20 } };
+        const surface = try view.draw(ctx);
+        try std.testing.expect(surface.size.width <= size.width and surface.size.height <= size.height);
+        const body = if (size.height >= 2 and size.width >= 8) surface.children[surface.children.len - 1].surface else surface;
+        var placements: usize = 0;
+        for (body.buffer, 0..) |cell, i| if (cell.image) |img| {
+            placements += 1;
+            try std.testing.expectEqual(@as(u32, 42), img.img_id);
+            try std.testing.expect(i / body.size.width + img.options.size.?.rows.? <= body.size.height);
+            try std.testing.expect(i % body.size.width + img.options.size.?.cols.? <= body.size.width);
+        };
+        try std.testing.expectEqual(@as(usize, 1), placements);
+    }
+}
+
+fn buttonWidget(button: *vxfw.Button) vxfw.Widget {
+    return .{ .userdata = button, .drawFn = drawButton, .eventHandler = buttonEvent };
+}
+fn drawButton(ptr: *anyopaque, ctx: vxfw.DrawContext) std.mem.Allocator.Error!vxfw.Surface {
+    const button: *vxfw.Button = @ptrCast(@alignCast(ptr));
+    var surface = try button.draw(ctx);
+    surface.widget = buttonWidget(button);
+    return surface;
+}
+fn buttonEvent(ptr: *anyopaque, ctx: *vxfw.EventContext, event: vxfw.Event) anyerror!void {
+    const button: *vxfw.Button = @ptrCast(@alignCast(ptr));
+    const consumed = ctx.consume_event;
+    try button.handleEvent(ctx, event);
+    if (event == .mouse_enter) ctx.consume_event = consumed;
+}
+
+pub fn transmitPng(writer: *std.Io.Writer, encoded: []const u8, id: u32, width: u16, height: u16) !void {
+    if (encoded.len == 0) return error.InvalidImage;
+    var offset: usize = 0;
+    while (offset < encoded.len) {
+        const end = @min(encoded.len, offset + 4096);
+        const more: u8 = @intFromBool(end < encoded.len);
+        if (offset == 0) try writer.print("\x1b_Gf=100,s={d},v={d},i={d},q=2,m={d};", .{ width, height, id, more }) else try writer.print("\x1b_Gm={d};", .{more});
+        try writer.writeAll(encoded[offset..end]);
+        try writer.writeAll("\x1b\\");
+        offset = end;
+    }
+    try writer.flush();
+}
+
+test "PNG uploads terminate exactly once at protocol chunk boundaries" {
+    const allocator = std.testing.allocator;
+    for ([_]usize{ 4, 4092, 4096, 4100, 8192 }) |len| {
+        const encoded = try allocator.alloc(u8, len);
+        defer allocator.free(encoded);
+        @memset(encoded, 'A');
+        var writer: std.Io.Writer.Allocating = .init(allocator);
+        defer writer.deinit();
+        try transmitPng(&writer.writer, encoded, 7, 800, 600);
+        const output = writer.written();
+        try std.testing.expect(std.mem.indexOf(u8, output, "q=2") != null);
+        try std.testing.expectEqual(@as(usize, 1), std.mem.count(u8, output, "m=0;"));
+        try std.testing.expectEqual((len - 1) / 4096, std.mem.count(u8, output, "m=1;"));
+        try std.testing.expect(std.mem.endsWith(u8, output, "\x1b\\"));
+    }
+}
diff --git a/Shelly.Tui/src/views/operation_view.zig b/Shelly.Tui/src/views/operation_view.zig
new file mode 100644
index 00000000..1ce25806
--- /dev/null
+++ b/Shelly.Tui/src/views/operation_view.zig
@@ -0,0 +1,470 @@
+const std = @import("std");
+const Border = @import("border.zig");
+const commands = @import("../commands.zig");
+const diagnostics = @import("diagnostics");
+const operation = @import("../services/shelly_operation.zig");
+const vaxis = @import("vaxis");
+const vxfw = vaxis.vxfw;
+const Allocator = std.mem.Allocator;
+
+/// Borrowed operation state. Password input goes directly to sudo's terminal.
+pub const View = struct {
+    name: []const u8,
+    backend: operation.Backend = .standard,
+    elevated: bool = true,
+    combined: bool = false,
+    include_aur: bool = true,
+    include_flatpak: bool = true,
+    target: ?operation.FlatpakTarget = null,
+    action: operation.Action = .install,
+    state: enum { entering, running, succeeded, failed, declined },
+    review: []const u8 = "",
+    detail: []const u8 = "",
+    progress: operation.Progress = .{},
+    refresh_pending: bool = false,
+
+    fn confirmation(self: View, arena: Allocator) Allocator.Error![]const u8 {
+        if (self.review.len > 0) return std.mem.trim(u8, self.review, "\r\n");
+        const target = if (self.target) |value|
+            try std.fmt.allocPrint(arena, "\nScope: {s}\nRemote: {f}\nBranch: {f}\nArchitecture: {f}", .{
+                @tagName(value.scope),                                                          diagnostics.safe(value.remote),
+                diagnostics.safe(if (value.branch.len > 0) value.branch else "remote default"), diagnostics.safe(if (value.arch.len > 0) value.arch else "remote default"),
+            })
+        else
+            "";
+        const note: []const u8 = if (self.combined)
+            if (self.include_aur)
+                if (self.include_flatpak) "System packages, AUR, and system/user Flatpaks. PKGBUILDs require review. AppImage updates are detected but not managed by the TUI." else "System packages and AUR. Flatpak disabled or unavailable. PKGBUILDs require review. AppImage updates are detected but not managed by the TUI."
+            else if (self.include_flatpak) "System packages and system/user Flatpaks. AUR excluded. AppImage updates are detected but not managed by the TUI." else "Full system upgrade. AUR and Flatpak excluded. AppImage updates are detected but not managed by the TUI."
+        else if (self.backend == .flatpak)
+            if (self.action == .upgrade) "Updates system and user Flatpaks as the invoking user. System changes may require a Flatpak authorization agent." else if (self.action == .remove) "Configuration and unused dependencies will be kept." else "Uses the selected remote and scope. Shelly handles dependencies and review."
+        else if (self.action == .remove) "Unused dependencies and configuration will be kept." else if (self.action == .upgrade)
+            if (self.backend == .aur) "Upgrade AUR packages and required dependencies. PKGBUILDs require review." else "Full system upgrade. AUR and Flatpak excluded. AppImage updates are detected but not managed by the TUI."
+        else if (self.backend == .aur) "PKGBUILDs require review before installation." else "";
+        return std.fmt.allocPrint(arena, "{s} {f}?{s}\n\n{s}", .{ self.action.verb(), diagnostics.safe(self.name), target, note });
+    }
+
+    fn body(self: View, arena: Allocator, width: u16) Allocator.Error![]const u8 {
+        if (self.state == .entering) return self.confirmation(arena);
+        const outcome = switch (self.state) {
+            .entering => unreachable,
+            .running => "",
+            .succeeded => try std.fmt.allocPrint(arena, "{s} {f} successfully.{s}", .{ self.action.completed(), diagnostics.safe(self.name), if (self.refresh_pending) "\nRefreshing package state…" else "" }),
+            .declined => try std.fmt.allocPrint(arena, "Declined {s} for {f}.\nSome dependency changes may already have completed.", .{ @tagName(self.action), diagnostics.safe(self.name) }),
+            .failed => try std.fmt.allocPrint(arena, "Could not {s} {f}.\n\n{f}{s}", .{
+                @tagName(self.action),                                                                           diagnostics.safe(self.name),
+                diagnostics.safe(if (self.detail.len > 0) self.detail else "Shelly returned no error details."), if (self.combined) "\nSome sources may already have completed. Package state will be refreshed." else "",
+            }),
+        };
+        const progress = if (if (self.state == .running) self.progress.percent else null) |reported| blk: {
+            const percent = @min(@max(reported, 0), 100);
+            const bar_width: usize = width -| 7;
+            const bar = try arena.alloc(u8, bar_width);
+            const filled = bar_width * @as(usize, @intCast(percent)) / 100;
+            @memset(bar[0..filled], '#');
+            @memset(bar[filled..], '-');
+            break :blk try std.fmt.allocPrint(arena, "[{s}] {d: >3}%", .{ bar, percent });
+        } else "";
+        var lines: std.ArrayList([]const u8) = .empty;
+        if (self.progress.authenticating) {
+            if (self.progress.authentication_len > 0)
+                try lines.append(arena, try authenticationText(arena, self.progress.authentication[0..self.progress.authentication_len]));
+        }
+        var last: []const u8 = "";
+        for (&self.progress.messages, self.progress.lengths) |*message, len| {
+            const text = std.mem.trim(u8, message[0..len], " \t\r\n");
+            if (text.len == 0) continue;
+            try lines.append(arena, try diagnostics.sanitizeAlloc(arena, text));
+            last = text;
+        }
+        const status = std.mem.trim(u8, self.progress.text(), " \t\r\n");
+        if (status.len > 0 and !std.mem.eql(u8, status, last))
+            try lines.append(arena, try diagnostics.sanitizeAlloc(arena, status));
+        if (lines.items.len == 0 and self.state == .running) try lines.append(arena, "Waiting for progress…");
+        if (progress.len > 0) try lines.append(arena, progress);
+        if (outcome.len > 0) try lines.append(arena, outcome);
+        return std.mem.join(arena, "\n", lines.items);
+    }
+};
+
+// PTYs emit CRLF and PAM can emit standalone carriage returns. Rendering both as line breaks before sanitizing.
+fn authenticationText(allocator: Allocator, bytes: []const u8) Allocator.Error![]const u8 {
+    const normalized = try allocator.alloc(u8, bytes.len);
+    defer allocator.free(normalized);
+    var len: usize = 0;
+    for (bytes, 0..) |byte, index| {
+        if (byte == '\n' and index > 0 and bytes[index - 1] == '\r') continue;
+        normalized[len] = if (byte == '\r') '\n' else byte;
+        len += 1;
+    }
+    return diagnostics.sanitizeAlloc(allocator, normalized[0..len]);
+}
+
+pub const Action = enum { none, close, confirm };
+
+/// Persistent local interaction state. The coordinator owns this component and
+/// its borrowed View data; builders never retain pointers into the draw arena.
+pub const Panel = struct {
+    view: View = .{ .name = "", .state = .entering },
+    scroll: vxfw.ScrollView = .{ .children = .{ .slice = &.{} } },
+    initialized: bool = false,
+    ready: bool = false,
+    follow_output: bool = true,
+
+    fn update(self: *Panel, view: View) void {
+        if (!self.initialized) {
+            self.scroll = .{ .item_count = 1, .children = .{ .builder = .{ .userdata = self, .buildFn = buildBody } } };
+            self.initialized = true;
+        }
+        if (self.view.state == .entering and view.state != .entering) {
+            self.scroll.scroll = .{};
+            self.follow_output = true;
+        }
+        self.view = view;
+    }
+
+    pub fn handleKey(self: *Panel, view: View, ctx: *vxfw.EventContext, key: vaxis.Key) !Action {
+        self.update(view);
+        if (view.state != .entering and view.state != .running and commands.closesResult(key)) return .close;
+        if (view.state == .entering) {
+            if (commands.matches(key, .cancel) or (!view.elevated and commands.matches(key, .close))) return .close;
+            if (commands.matches(key, .confirm)) {
+                if (self.ready) return .confirm;
+                return .none;
+            }
+        }
+        if (commands.scrollsOperation(key)) {
+            const scroll_key = commands.scrollKey(key).?;
+            if (scroll_key.matches(vaxis.Key.page_down, .{})) {
+                if (self.scroll.scroll.linesDown(@max(self.scroll.last_height, 1))) ctx.consumeAndRedraw();
+            } else if (scroll_key.matches(vaxis.Key.page_up, .{})) {
+                if (self.scroll.scroll.linesUp(@max(self.scroll.last_height, 1))) ctx.consumeAndRedraw();
+            } else try self.scroll.handleEvent(ctx, .{ .key_press = scroll_key });
+            return .none;
+        }
+        return .none;
+    }
+
+    pub fn draw(self: *Panel, view: View, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+        self.update(view);
+        const size = ctx.max.size();
+        self.ready = size.width >= 24 and size.height >= 3;
+        if (!self.ready) {
+            var text: vxfw.Text = .{ .text = "Enlarge the terminal to view the operation." };
+            return text.draw(ctx);
+        }
+        const title = if (view.progress.authenticating)
+            "Authentication"
+        else if (view.state == .entering)
+            (if (view.elevated) "Authentication" else "Confirmation")
+        else
+            try std.fmt.allocPrint(ctx.arena, "{s} {f} — {s}", .{
+                view.action.verb(), diagnostics.safe(view.name),
+                switch (view.state) {
+                    .entering => if (view.elevated) "Authentication" else "Confirmation",
+                    .running => "Running",
+                    .succeeded => "Complete",
+                    .failed => "Failed",
+                    .declined => "Declined",
+                },
+            });
+        const labels = [_]Border.BorderLabel{.{ .text = title, .alignment = .top_left }};
+        var border: Border = .{ .child = .{ .userdata = self, .drawFn = drawContent }, .labels = &labels };
+        return border.draw(ctx.withConstraints(size, .{ .width = size.width, .height = size.height }));
+    }
+
+    fn buildBody(ptr: *const anyopaque, index: usize, _: usize) ?vxfw.Widget {
+        if (index != 0) return null;
+        return .{ .userdata = @constCast(ptr), .drawFn = drawBody };
+    }
+
+    fn drawBody(ptr: *anyopaque, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+        const self: *Panel = @ptrCast(@alignCast(ptr));
+        const width = ctx.max.width orelse ctx.min.width;
+        var text: vxfw.Text = .{ .text = try self.view.body(ctx.arena, width), .softwrap = true };
+        return text.draw(ctx.withConstraints(.{ .width = width }, .{ .width = width, .height = null }));
+    }
+
+    fn drawContent(ptr: *anyopaque, ctx: vxfw.DrawContext) Allocator.Error!vxfw.Surface {
+        const self: *Panel = @ptrCast(@alignCast(ptr));
+        const view = self.view;
+        const size = ctx.max.size();
+        const review_height = size.height;
+        if (view.state != .entering) {
+            // Upward keyboard or wheel navigation pauses following.
+            if (self.scroll.scroll.pending_lines < 0) self.follow_output = false;
+            if (self.follow_output) {
+                const document = try drawBody(self, ctx);
+                self.scroll.scroll.top = 0;
+                self.scroll.scroll.vertical_offset = @intCast(document.size.height -| review_height);
+                self.scroll.scroll.pending_lines = 0;
+            }
+        }
+        const output = try self.scroll.draw(ctx.withConstraints(.{}, .{ .width = size.width, .height = review_height }));
+        if (view.state != .entering and !self.scroll.scroll.has_more_vertical) self.follow_output = true;
+        const children = try ctx.arena.alloc(vxfw.SubSurface, 1);
+        children[0] = .{ .origin = .{ .row = 0, .col = 0 }, .surface = output };
+        return .{ .size = size, .widget = .{ .userdata = self, .drawFn = drawContent }, .buffer = &.{}, .children = children };
+    }
+};
+
+test "direct sudo authentication has no password field and sanitizes terminal output" {
