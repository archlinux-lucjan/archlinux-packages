9c7be6a21fe79613edf92c27ff0b74bbe4f517c7 # scx_cake: identity-gated preempt fast paths + RT-owned CPU avoidance
7871200abaf24ddb45f3338cbb5046322b87efb5 # scheds: Introduce scx_maestro
217c4062b56a3b84d02c81d02ca8992e67c853d3 # scx_maestro: Honor cgroup cpu.weight for tasks and sub-schedulers
f7be123ea6e980b58f1fdf9d5f18bb39d310ced6 # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
3d6facb0d4656c0f6fbeda03c3db240e2e686e6a # scx_maestro: Don't update deadline in case of re-enqueue
27a05044ce5af71d73d4b8708145097184619526 # scx_maestro: Introduce completely fair scheduling
e441222c36ed7ea7afd4ff12bb85e758193075d2 # scx_maestro: Make enqueue + CPU kick more reliable
2531e1b82fee824bb915ae453f91185b3b53a786 # scx_maestro: Enforce preemption each tick on CPU contention
0d52e6d90c6b4df73c78b6343cee92cbf4b09f48 # scx_maestro: Temporarily drop sub-sched support
968b8bae7a3149c74109befbe58c2ccfe2275a8d # scx_maestro: bump to 1.1.1
41702d1b6803ab66a9f0ccef8961231b9cd9f3f0 # scx_maestro: fix formatting
30ff88d3a303f16a5922bc726fb207159428ad30 # scx_maestro: bump to 1.1.2
aa1e8f6dacf505223db37e00836b54249081720d # scx_maestro: Use scx_bpf_task_set_slice() setter
efaf195cfb4f80b60337f8bd51040ec9415b53ad # Cargo: update dependencies to latest versions
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_rlfifo \
     --exclude scx_characterize \
     --exclude xtask \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +
}
