29ffb0a65d0576ee45e49658998c1a239321b7b6 # scheds: Introduce scx_maestro
01d92d941778054167eae50d6cceb297eb14e042 # scx_maestro: Honor cgroup cpu.weight for tasks and sub-schedulers
fadeacc1e5b7d840a2ae2f722095e6403f7bd0cb # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
cfdc2e6cb9d034bad18907496ee3fc26a515a44d # scx_maestro: Don't update deadline in case of re-enqueue
43591bbb3eec3372465e988b38af64e859eb11ed # scx_maestro: Introduce completely fair scheduling
d574532186f843ee26927ffe383ff12786a2bbff # scx_maestro: Make enqueue + CPU kick more reliable
b2b1ce28450f20e9797bd93fc16662a0d71f533b # scx_maestro: Enforce preemption each tick on CPU contention
96abcbdfe08e126155f52a7411cf332efd91826f # scx_maestro: Temporarily drop sub-sched support
dce261ad674009ce7142ccc8e1406b0818b023d1 # scx_maestro: bump to 1.1.1
f409e32a4c3dcd918f0e3a383ffd33f3772387b1 # scx_maestro: fix formatting
6bc70fc946724123ab128cb92c662d822a7e6b4d # scx_maestro: bump to 1.1.2
722bc39ab6f7ac40a3064b80b68296db1cf39600 # scx_maestro: Use scx_bpf_task_set_slice() setter
4edbb312807fff6ef1e131ff09a591dd3ceba477 # Cargo: update dependencies to latest versions
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_rlfifo \
     --exclude scx_characterize \
     --exclude xtask \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +
}
