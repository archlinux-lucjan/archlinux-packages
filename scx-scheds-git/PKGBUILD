# Available profiles: “release”, “release-tiny”, “release-fast“
# See: https://github.com/sched-ext/scx/blob/main/Cargo.toml
_mode=release

pkgname=scx-scheds-git
_gitname=scx
pkgver=1.1.3.r121.g8af1809d3
pkgrel=1
pkgdesc='sched_ext schedulers and tools'
url='https://github.com/sched-ext/scx'
arch=('x86_64')
license=('GPL-2.0-only')
depends=(
  libseccomp
  libelf
  zlib
)
makedepends=(
  cargo
  clang
  git
  llvm
  llvm-libs
)
optdepends=(
'scx-tools: scx_loader and scxctl - A DBUS Interface for Managing sched_ext Schedulers '
)
options=(!lto)
provides=("scx-scheds")
conflicts=("scx-scheds")
source=("git+https://github.com/sched-ext/scx")
sha256sums=('SKIP')

_backports=(
a4aaf1feaabd9e8e25ddcf171967c658ed80b71c # scheds: Introduce scx_maestro
60e442af08762d984cdebd6354098c2f1b8d98c4 # scx_maestro: Honor cgroup cpu.weight for tasks and sub-schedulers
66ca664f1f8b546d2a953abf3307e9e2af5f7234 # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
7c21340626e00060b798d9080533f83096ab7532 # scx_maestro: Don't update deadline in case of re-enqueue
6725328a12075fad04d86f390a4e0654dd66a163 # scx_maestro: Introduce completely fair scheduling
1e52318d4a53e82df8d744134c3373d81bc304fe # scx_maestro: Make enqueue + CPU kick more reliable
403514a34b9646000c191331cfeb102627ee1c42 # scx_maestro: Enforce preemption each tick on CPU contention
3c204de6220105b0dd1be09bb64242ac4c7faf63 # scx_maestro: Temporarily drop sub-sched support
50984d988a92c5919aafb25ea837102114772197 # scx_maestro: bump to 1.1.1
c9353847cfd3200045eb1d8be0f47c7290efd604 # scx_maestro: fix formatting
b2e5baec2fc47bf3dddc59d470c1b6dea39b3403 # scx_maestro: bump to 1.1.2
d240f357c5164317bced242cd51171e248edcffb # scx_maestro: Use scx_bpf_task_set_slice() setter
c08688fa84d08ed7d94fc0cea16a61af4bdd4223 # scx_maestro: bump to 1.1.3
fb7380c3b08a05b5fc8e3b95afa52c3c5bdb2944 # scx_maestro: bump libbpf to 0.27.0
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_rlfifo \
     --exclude scx_characterize \
     --exclude xtask \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +
}
