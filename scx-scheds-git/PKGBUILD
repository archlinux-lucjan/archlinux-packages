cc89a509c0c1c74ce0451a9c4a3a5e0fb55f838d # scheds: Introduce scx_maestro
e623ff4d489773cc9f6fcb2723d07b91cf69b4a1 # scx_maestro: Honor cgroup cpu.weight for tasks and sub-schedulers
2cd981c18c316c7ba9a0f78ad9ca643f64734b21 # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
0ce9e876741af5d23f0118f82b3a54dfc6799782 # scx_maestro: Don't update deadline in case of re-enqueue
19104b30a538ccc44e9aa6cbc050f9df6bb9e5d7 # scx_maestro: Introduce completely fair scheduling
5e9e5d70c33d2c870d83b87e719530c526657580 # scx_maestro: Make enqueue + CPU kick more reliable
ab68e5112af308c316a4b10e67fe284dce930a29 # scx_maestro: Enforce preemption each tick on CPU contention
36cedcf9ed0c37f3330f0514c5afc4313b7ed218 # scx_maestro: Temporarily drop sub-sched support
c2fd37f2a39ffd05758fe2b22d2abaed47760333 # scx_maestro: bump to 1.1.1
76460d444f561bf4d274dbc09c479303d3c0332d # scx_maestro: fix formatting
4d0dbe66099b802552615da465d99dc5d9e12ecf # scx_maestro: bump to 1.1.2
2fe467bcc0108ca998f831996f1f8793c45938c9 # scx_maestro: Use scx_bpf_task_set_slice() setter
eaedd1b92f5e2032c2b607cfecc0719ae0255c9b # Cargo: update dependencies to latest versions
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_rlfifo \
     --exclude scx_characterize \
     --exclude xtask \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +
}
