84f075eb365dbcb55d463b433aa274ad609cb119 # scx_maestro: Make enqueue + CPU kick more reliable
061d3c80dc799f0834d499d1c5af598a4fee157c # scx_maestro: Enforce preemption each tick on CPU contention
e9bc14871d6a8ed68a8eb2d778be15652dfb457b # scx_maestro: Temporarily drop sub-sched support
c914520c9da9ac2868c7434f0dd5451aea6facbd # scx_maestro: bump to 1.1.1
b52967713ee3542aad9e261289166c6e6a8c1d9a # scx_maestro: fix formatting
