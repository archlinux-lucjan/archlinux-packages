# Available profiles: “release”, “release-tiny”, “release-fast“
# See: https://github.com/sched-ext/scx/blob/main/Cargo.toml
_mode=release

pkgname=scx-scheds-git
_gitname=scx
pkgver=1.1.2.r26.gdaf64b596
pkgrel=1
pkgdesc='sched_ext schedulers and tools'
url='https://github.com/sched-ext/scx'
arch=('x86_64')
license=('GPL-2.0-only')
depends=(
  libseccomp
  libelf
  zlib
)
makedepends=(
  cargo
  clang
  git
  llvm
  llvm-libs
)
optdepends=(
'scx-tools: scx_loader and scxctl - A DBUS Interface for Managing sched_ext Schedulers '
)
options=(!lto)
provides=("scx-scheds")
conflicts=("scx-scheds")
source=("git+https://github.com/sched-ext/scx")
sha256sums=('SKIP')

_backports=(
e3f4aae56a623de2aed0924ac88e95389a40e2c7 # scx_cake: 1.2.0 — clean-slate EEVDF-parity rewrite
3b9c7bb9db5354f5feebdbce7ed523dc35bbc975 # scx_cake: identity-gated preempt fast paths + RT-owned CPU avoidance
51f26c40a7356a7c4fd441d32b376b455e0808bc # scheds: Introduce scx_maestro
d7d6353865adf9781a264545b00465ff382f806d # scx_maestro: Honor cgroup cpu.weight for tasks and sub-schedulers
9ed2a87393d54205a60758893bbdea9b82c047fe # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
bc074671faab77a04a8a6bcefb3b4e47608bc0ab # scx_maestro: Don't update deadline in case of re-enqueue
322907cb2df926e7133152b3d277d9a73669b5c0 # scx_maestro: Introduce completely fair scheduling
b1b9eb7599b8ca4fe63727c5f70f3c3b0f81783b # scx_maestro: Make enqueue + CPU kick more reliable
fe8f2f078221a4d972ec47d97a55875b13dabf05 # scx_maestro: Enforce preemption each tick on CPU contention
5bb0072a6b76bd00231f638c3358e99e6b54ec05 # scx_maestro: Temporarily drop sub-sched support
bf29e964609628b4605aedfabf9374a64714e8e8 # scx_maestro: bump to 1.1.1
7e9b8d879dc5253e724d12cec6b570963ac60fe7 # scx_maestro: fix formatting
d343436b456f5bbf1e7ce3c4455cf405ab6688aa # scx_maestro: bump to 1.1.2
8aff47ecefeb40f5766b56dc8d2eef79a4820daa # scx_maestro: Use scx_bpf_task_set_slice() setter
7c8d56820a44575523ffd6d460fdfe467fbe569f # Cargo: update dependencies to latest versions
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_rlfifo \
     --exclude scx_characterize \
     --exclude xtask \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +
}
