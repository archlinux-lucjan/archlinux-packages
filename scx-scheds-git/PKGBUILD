6d1dc4bf54fbbc2f8eadb6c4262eec059afdcd38 # scx_cake: identity-gated preempt fast paths + RT-owned CPU avoidance
75a522ceb308499875dcbbf1ba0f9d9f6a315347 # scheds: Introduce scx_maestro
600b411a0b0deaa376543b7ed91984e56876d05a # scx_maestro: Honor cgroup cpu.weight for tasks and sub-schedulers
78e77ab8727c4f5ca5913fa1fc745102e8e49474 # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
ccd341842283d07920fc7b7a568b559e4905852a # scx_maestro: Don't update deadline in case of re-enqueue
2899fd791916243dda352df8de236b715399163f # scx_maestro: Introduce completely fair scheduling
bf279082eacb5fe1c4e958555990d285108d3193 # scx_maestro: Make enqueue + CPU kick more reliable
f4a6cc06a8564cf018e6fb326141af683abd8a28 # scx_maestro: Enforce preemption each tick on CPU contention
14790752d2628f414ddb2bc81794902fec8a3aa7 # scx_maestro: Temporarily drop sub-sched support
5fe541b32967c96e5e6161bed8c811d8fd7d8db1 # scx_maestro: bump to 1.1.1
8fc27fc6b95acd8c9be96401fbe9ac5b60904426 # scx_maestro: fix formatting
8d3bfc3d2ca96aed08f5230004e543df36a88df1 # scx_maestro: bump to 1.1.2
b22cf2fb56c69150758b521544269679f397c024 # scx_maestro: Use scx_bpf_task_set_slice() setter
1539cc6a3a7d2f762bffcde194ef7cb35bd1b15a # Cargo: update dependencies to latest versions
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_rlfifo \
     --exclude scx_characterize \
     --exclude xtask \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +
}
