ee8857753ff0141fcea5c0f4ae10cead8b71ce90 # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
1cd25e5fbcb3444756543c6ea51cbeeaa5384302 # scx_maestro: Don't update deadline in case of re-enqueue
eb57bb64ae09c9c534ee263c9220f24aa535eac4 # scx_maestro: Introduce completely fair scheduling
9a46f0e6002b95d7dde7cd2c26f4a06aa8cb33c9 # scx_maestro: Make enqueue + CPU kick more reliable
f4423e8d3207bdcd16310686a75c9a5a72515dba # scx_maestro: Enforce preemption each tick on CPU contention
fe2156080a77eb1f8a14a392edd456f66e201a72 # scx_maestro: Temporarily drop sub-sched support
a9cbee4b05cf91f0432306cebfdbd7001ed8c02c # scx_maestro: bump to 1.1.1
ba37750c4983c08fee73e1f9a89ac15ab4b7346f # scx_maestro: fix formatting
1a9699810e2d6ed70e245e2660d18e9c4e537605 # scx_maestro: bump to 1.1.2
8e380d5c3ca1354fe3cb1d8210cf10a2580df9cd # scx_maestro: Use scx_bpf_task_set_slice() setter
75ecd78c7c91db496a1696d01dcbcd697816ad5d # scx_maestro: bump to 1.1.3
aa2c9251c7121d0302c4be98c890dbf51ae0ef25 # Cargo: update dependencies to latest versions
2b06c722f0f492c41b03586915f62461a9028842 # Cargo: update libbpf to latest versions
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_rlfifo \
     --exclude scx_characterize \
     --exclude xtask \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +
}
