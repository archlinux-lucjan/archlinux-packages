# Available profiles: “release”, “release-tiny”, “release-fast“
# See: https://github.com/sched-ext/scx/blob/main/Cargo.toml
_mode=release

pkgname=scx-scheds-git
_gitname=scx
pkgver=1.1.3.r1.gafab76ebc
pkgrel=1
pkgdesc='sched_ext schedulers and tools'
url='https://github.com/sched-ext/scx'
arch=('x86_64')
license=('GPL-2.0-only')
depends=(
  libseccomp
  libelf
  zlib
)
makedepends=(
  cargo
  clang
  git
  llvm
  llvm-libs
)
optdepends=(
'scx-tools: scx_loader and scxctl - A DBUS Interface for Managing sched_ext Schedulers '
)
options=(!lto)
provides=("scx-scheds")
conflicts=("scx-scheds")
source=("git+https://github.com/sched-ext/scx")
sha256sums=('SKIP')

_backports=(
384add92116c1d921ea5f7750c69a15011327543 # scheds: Introduce scx_maestro
0f30d1d60d2e7dfa98a7fe5251ce3b4bb85662a4 # scx_maestro: Honor cgroup cpu.weight for tasks and sub-schedulers
8c7022ee6b4dc5d8eae1ebc4f7bb0f4e7ae1dede # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
92ad978d60c3fddead5738ce691f8ce966a23407 # scx_maestro: Don't update deadline in case of re-enqueue
227ce529871fb8994eb0447429fa50882111664d # scx_maestro: Introduce completely fair scheduling
b5c81cf52ed276aaa9031f225be8ab82732d462d # scx_maestro: Make enqueue + CPU kick more reliable
66d1ccbb325e48ac0474811973ba870427a41724 # scx_maestro: Enforce preemption each tick on CPU contention
6bc21744b99138acfe7aa97c027db82a61d5f028 # scx_maestro: Temporarily drop sub-sched support
0e9f8a35bbf7483e2e0d0e4f4f64e010682aae84 # scx_maestro: bump to 1.1.1
a2650461334db3a2c7da01798cf8a8a345114f78 # scx_maestro: fix formatting
6dc839bbdee099d9f19494a5e9130568933ad51f # scx_maestro: bump to 1.1.2
e0e731b57820b4519be8d92d538899752e56a329 # scx_maestro: Use scx_bpf_task_set_slice() setter
634b73f6e24feba9609bd29dca7a6fabcae2c15b # scx_maestro: bump to 1.1.3
3ab665a9cdd3b638da0599a08c50539a933dd0fb # Cargo: update dependencies to latest versions
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_rlfifo \
     --exclude scx_characterize \
     --exclude xtask \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +
}
