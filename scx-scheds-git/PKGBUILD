1bab16cdf903b231f108ab0f84f30b60521c94cc # scx_cake: identity-gated preempt fast paths + RT-owned CPU avoidance
69a50830650490523f06dc5eb67492f693217876 # scheds: Introduce scx_maestro
3d79a1990130a60e2cc86226358edcf22358c150 # scx_maestro: Honor cgroup cpu.weight for tasks and sub-schedulers
3c1257e34300141505feb3c49312e4a20255188c # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
af3b3e4c3c9a67172d97c8895582a7d2585d2235 # scx_maestro: Don't update deadline in case of re-enqueue
1521d14b727ad1585268b7da239f53c4fa02303b # scx_maestro: Introduce completely fair scheduling
2017df00ab6884bf18e9f68d435edbc9ed8c7ea9 # scx_maestro: Make enqueue + CPU kick more reliable
c3f1ff7943d138e88197080d395e289b4eacd65c # scx_maestro: Enforce preemption each tick on CPU contention
a4281743a28642d0154e1509799c2ec1b478b4e3 # scx_maestro: Temporarily drop sub-sched support
7e77f11af185c7e4e58e019cd19409ca446b4785 # scx_maestro: bump to 1.1.1
2aeddef5e009d73df8a15a111d709d924cfb68a1 # scx_maestro: fix formatting
e18ac731cf0c65aa9eaf14924097612b7383e62f # scx_maestro: bump to 1.1.2
481bc6f285f5016ea916f8ed45eba3d0b4f44573 # scx_maestro: Use scx_bpf_task_set_slice() setter
76447fcd7adce60e082e7b4f199407e1bcbda44e # Cargo: update dependencies to latest versions
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_rlfifo \
     --exclude scx_characterize \
     --exclude xtask \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +
}
