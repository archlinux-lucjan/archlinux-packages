d0256e4eeb4f2a0472d36426ea881176a543bb8a # scx_maestro: Make enqueue + CPU kick more reliable
62df704e27c08330d9aa67c86678260be22fd7b5 # scx_maestro: Enforce preemption each tick on CPU contention
c9849fd31227e76105949368e14cf40f0e81f25b # scx_maestro: Temporarily drop sub-sched support
5f15d46e42f4605e4b1fcf42213650df21adacdf # scx_maestro: bump to 1.1.1
2fb501460d82598520038bbc91f7bc87adec79fc # scx_maestro: fix formatting
54f57347afb4675906800041f044e6bb8b98b825 # scx_maestro: bump to 1.1.2
91a36465e8fb6402b25d79cd2ed64fbb33feca08 # scx_maestro: Use scx_bpf_task_set_slice() setter
c224a81da186e3e42917195d968a94ac674586ec # scx_maestro: bump to 1.1.3
d8fe92ba074c2db52638e120d75dc779f456eee3 # scx_mlfq: bump to 1.3.5
