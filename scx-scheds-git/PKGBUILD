ebde1aa5aff0f64610f3b8535ca4847d017b63e2 # scx_maestro: Don't update deadline in case of re-enqueue
37cbedee203f27bcf34cc3fe20562fe7d677f7cf # scx_maestro: Introduce completely fair scheduling
cc525a4f5bbaca32cbf5d74a80fb221f34cd2170 # scx_maestro: Make enqueue + CPU kick more reliable
25b4d38a270c45f275476afb30c388bc5cdbfb7d # scx_maestro: Enforce preemption each tick on CPU contention
d9feeaf55115547259ac166411df8f8fc02348b1 # scx_maestro: Temporarily drop sub-sched support
1534d237413c6e5eb229a5924507de6e9913d097 # scx_maestro: bump to 1.1.1
70a339d75d7b0f66a9d5103c08f3d9cdc7e57b9b # scx_maestro: fix formatting
0625f3899ba1362467e6f0acf8804e49f005d464 # scx_maestro: bump to 1.1.2
c790e1bca9a5410a746c3764382fd99ea00c2e7b # scx_maestro: Use scx_bpf_task_set_slice() setter
