0f3ce13cff29d9f02cb4f806f7bd89fc1821eb75 # scheds: Introduce scx_maestro
5a3f89ef81755473d218b809775bf57af1c1eaec # scx_maestro: Honor cgroup cpu.weight for tasks and sub-schedulers
59bf868f7538e734406279cbae35c0d03d5489da # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
e8768e538e3c1be036ed5b41f17e2291a158547a # scx_maestro: Don't update deadline in case of re-enqueue
5a3f25f523339f26e83b54bf9c21ae4b5c1c69ae # scx_maestro: Introduce completely fair scheduling
086e54eb60dd11729177b14803b676e5faab0b52 # scx_maestro: Make enqueue + CPU kick more reliable
42fce2ab1a32c22cda5bb40685697ee1d914d826 # scx_maestro: Enforce preemption each tick on CPU contention
38738945a3c80f36d83ff352c0cd97124bcb6058 # scx_maestro: Temporarily drop sub-sched support
