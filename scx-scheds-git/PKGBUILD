# Maintainer: Piotr Górski <lucjan.lucjanov@gmail.com>
# Contributor: Tejun Heo <tj@kernel.org>

# Available profiles: “release”, “release-tiny”, “release-fast“
# See: https://github.com/sched-ext/scx/blob/main/Cargo.toml
_mode=release

pkgname=scx-scheds-git
_gitname=scx
pkgver=1.1.5.r15.g0df97416e
pkgrel=2
pkgdesc='sched_ext schedulers and tools'
url='https://github.com/sched-ext/scx'
arch=('x86_64')
license=('GPL-2.0-only')
depends=(
  libelf
  polkit
  zlib
)
makedepends=(
  bpf-linker
  cargo
  clang
  git
  llvm
  rust-src
)
options=(!lto)
backup=('etc/default/scx')
provides=("scx-scheds")
conflicts=("scx-scheds" "scx-tools-git")
replaces=("scx-tools-git")
source=("git+https://github.com/sched-ext/scx")
sha256sums=('SKIP')

_backports=(
7bbbd1a7ea4ae41f7f6cc2b41681345a2ac76975 # scx_utils: Drop three more dependencies that nothing uses
74e305ac556ee8bd5ad8fe14c924db8b5fc4b37e # scheds: Drop dependencies that no scheduler source refers to
45b69ad6a33aab67095b8e84d6ef8795e29cb59a # scx_utils: Drop build-dependencies the build script does not use
1f599da365a0c3f4a456ebda7f73f62e8da9d136 # scx_flow: bump to 5.3.5
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_characterize \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests \
     --exclude scx_arena_libarena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' ! -name 'xtask' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +

  # Runtime data via xtask: scx.service, /etc/default/scx,
  # /usr/share/scx/catalog.json, the scxcli polkit policy.
  # --source-dir keeps cargo out of package().
  ./target/$_mode/xtask install --source-dir . --destdir "$pkgdir"
}
