04d8bd239821de9ed23a0295e7841d58fdf20a0b # scx_maestro: Honor cgroup cpu.weight for tasks and sub-schedulers
a27840448e0d3887cb15fa7d27592ec8e1b2ed44 # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
3b2b43b9d8493864f8c494f7f6915ba367690bf9 # scx_maestro: Don't update deadline in case of re-enqueue
3b6058513a9d0ed42314e5a9389e432052e4cf15 # scx_maestro: Introduce completely fair scheduling
a7ce0de4b00c77dde3f1b51b700d580b95beb9ce # scx_maestro: Make enqueue + CPU kick more reliable
ba7af7484b7e7100bf278a8e9462498becb04b32 # scx_maestro: Enforce preemption each tick on CPU contention
b9d726b8d2523f4837419b4a34c1317c1fa2a61c # scx_maestro: Temporarily drop sub-sched support
34e75d3a9fb18caaeddb6449071f84d07b5fcb69 # scx_maestro: bump to 1.1.1
444516bdf6cbc65b1b7261dcf89ef8ee78180531 # scx_maestro: fix formatting
c8b531dcd8066d88d98750a9778156fef321ecad # scx_maestro: bump to 1.1.2
a581514263d9a9a8024d3c1cb475f4f670943668 # scx_maestro: Use scx_bpf_task_set_slice() setter
eaf358526d574b3d16569430ebe2ce001d95ea19 # Cargo: update dependencies to latest versions
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_rlfifo \
     --exclude scx_characterize \
     --exclude xtask \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +
}
