# Available profiles: “release”, “release-tiny”, “release-fast“
# See: https://github.com/sched-ext/scx/blob/main/Cargo.toml
_mode=release

pkgname=scx-scheds-git
_gitname=scx
pkgver=1.1.2.r46.gdb1f0fd55
pkgrel=2
pkgdesc='sched_ext schedulers and tools'
url='https://github.com/sched-ext/scx'
arch=('x86_64')
license=('GPL-2.0-only')
depends=(
  libseccomp
  libelf
  zlib
)
makedepends=(
  cargo
  clang
  git
  llvm
  llvm-libs
)
optdepends=(
'scx-tools: scx_loader and scxctl - A DBUS Interface for Managing sched_ext Schedulers '
)
options=(!lto)
provides=("scx-scheds")
conflicts=("scx-scheds")
source=("git+https://github.com/sched-ext/scx")
sha256sums=('SKIP')

_backports=(
0c296bc9a6261b50b6800a573d8d96d855d66bae # scx_cake: 1.2.0 — clean-slate EEVDF-parity rewrite
e334bc3382fde4c3c22e609996fc728593e6fad8 # scx_cake: identity-gated preempt fast paths + RT-owned CPU avoidance
4fdcd0a36556551bcf59d307c76cd0eb3c9cd17a # scheds: Introduce scx_maestro
5ac56d7c62076eb38c8c783ed8044a0e49847730 # scx_maestro: Honor cgroup cpu.weight for tasks and sub-schedulers
b2cc2c56c42e8629e2e373697a28c23ff9bd897f # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
ee8380f8ba71167950d672abb55490d47101a971 # scx_maestro: Don't update deadline in case of re-enqueue
616dcd606460b5ac27f866b00790b3aa55a16178 # scx_maestro: Introduce completely fair scheduling
a650bc4e1d5140165cc1a6ea64ec5eb80e1a47d2 # scx_maestro: Make enqueue + CPU kick more reliable
7be189ee5a9c45fcbbda0a079c3e12df8ee67200 # scx_maestro: Enforce preemption each tick on CPU contention
896f8f49cae8fe6abff43419e24875f0ebcebd05 # scx_maestro: Temporarily drop sub-sched support
b5e90bf0b834d13060d31044f14e21e596a532ba # scx_maestro: bump to 1.1.1
b618563e134c7d99e8d2dda0ae27576db9ee9735 # scx_maestro: fix formatting
128629b1c497a30b19520447302a93bc17087509 # scx_maestro: bump to 1.1.2
17ac742bc749bc980d721cf383e3d076624bade6 # scx_maestro: Use scx_bpf_task_set_slice() setter
8d0ea6f7c33bfe65669a82e0e240cb133b42b852 # Cargo: update dependencies to latest versions
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_rlfifo \
     --exclude scx_characterize \
     --exclude xtask \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +
}
