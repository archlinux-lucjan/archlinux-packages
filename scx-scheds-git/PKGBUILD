# Available profiles: “release”, “release-tiny”, “release-fast“
# See: https://github.com/sched-ext/scx/blob/main/Cargo.toml
_mode=release

pkgname=scx-scheds-git
_gitname=scx
pkgver=1.1.2.r61.gd5cd4aa49
pkgrel=1
pkgdesc='sched_ext schedulers and tools'
url='https://github.com/sched-ext/scx'
arch=('x86_64')
license=('GPL-2.0-only')
depends=(
  libseccomp
  libelf
  zlib
)
makedepends=(
  cargo
  clang
  git
  llvm
  llvm-libs
)
optdepends=(
'scx-tools: scx_loader and scxctl - A DBUS Interface for Managing sched_ext Schedulers '
)
options=(!lto)
provides=("scx-scheds")
conflicts=("scx-scheds")
source=("git+https://github.com/sched-ext/scx")
sha256sums=('SKIP')

_backports=(
b85eff9dfde41293bd853d8a73e030bd0848ffa8 # scx_cake: 1.2.0 — clean-slate EEVDF-parity rewrite
142c54204028d3b205d451de12608acac1290dc6 # scx_cake: identity-gated preempt fast paths + RT-owned CPU avoidance
f962b77e11f624bdbbb4a0120936a0ef3dfa9188 # scheds: Introduce scx_maestro
a50cbf8aec1f9cc3f38824dcfda87db78acc15a3 # scx_maestro: Honor cgroup cpu.weight for tasks and sub-schedulers
f5712286a1119efadc67f9ddf4bf7b77fb26d3b8 # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
c05cee41be138e8861f34c265475cc22aa74faa6 # scx_maestro: Don't update deadline in case of re-enqueue
d6058a4277e223aba103949ea8174c863af9cf40 # scx_maestro: Introduce completely fair scheduling
4638f515282e50cb462949409bbf894026cb0b30 # scx_maestro: Make enqueue + CPU kick more reliable
d31dc6420e06e78993bdc5a89b32b766e1bc6019 # scx_maestro: Enforce preemption each tick on CPU contention
0dbb4f42edc2f534ba2a8e88c95ded7fb452ccb1 # scx_maestro: Temporarily drop sub-sched support
4ebea0b81a275b423f3147efb9f64b9b4a2145c3 # scx_maestro: bump to 1.1.1
ed132ddd94bd6b448cbf69c22bb1cdd10715fe44 # scx_maestro: fix formatting
55ab4a8a0b3b116e90d1f6fe6cfbc384659fa191 # scx_maestro: bump to 1.1.2
6e0da0659f4678f5969906b71f3fa7073066a205 # scx_maestro: Use scx_bpf_task_set_slice() setter
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_rlfifo \
     --exclude scx_characterize \
     --exclude xtask \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +
}
