c96167a37a1f2ef69d370aa662d39dacbf8c8fcb # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
c391082b1e287d732b698789054c95203e624e11 # scx_maestro: Don't update deadline in case of re-enqueue
7a287f7c64f0d365729809bc73e79a3c3c60f6e4 # scx_maestro: Introduce completely fair scheduling
a95cc8fe5abd4104334d2a25e1ef1f47da0d62d9 # scx_maestro: Make enqueue + CPU kick more reliable
57e78a6dcb3fcedc187567db6dbb9ba076760d0d # scx_maestro: Enforce preemption each tick on CPU contention
af9af6ba7a922469a61d3f560e1b7e588f378380 # scx_maestro: Temporarily drop sub-sched support
