# Available profiles: “release”, “release-tiny”, “release-fast“
# See: https://github.com/sched-ext/scx/blob/main/Cargo.toml
_mode=release

pkgname=scx-scheds-git
_gitname=scx
pkgver=1.1.2.r1.gd624f332
pkgrel=4
pkgdesc='sched_ext schedulers and tools'
url='https://github.com/sched-ext/scx'
arch=('x86_64')
license=('GPL-2.0-only')
depends=(
  libseccomp
  libelf
  zlib
)
makedepends=(
  cargo
  clang
  git
  llvm
  llvm-libs
)
optdepends=(
'scx-tools: scx_loader and scxctl - A DBUS Interface for Managing sched_ext Schedulers '
)
options=(!lto)
provides=("scx-scheds")
conflicts=("scx-scheds")
source=("git+https://github.com/sched-ext/scx")
sha256sums=('SKIP')

_backports=(
cca7814940d008301df4d8e0fce178b0047da056 # scx_cake: 1.2.0 — clean-slate EEVDF-parity rewrite
06c2bacfbf33aebe3a4e51709503ff12448d636e # scheds: Introduce scx_maestro
73cac1389d5985ec446038f026d047fe3fcf8407 # scx_maestro: Honor cgroup cpu.weight for tasks and sub-schedulers
7bc92ca4cce698c221b364c0f9efd62e3680223a # scx_maestro: Allow to enable/disable NUMA and SMT optimizations
df95c7ef7012bfb26c8b6f4eb8bddbc2474babfe # scx_maestro: Don't update deadline in case of re-enqueue
270e750ce48e97560a848adf358f3c10a82ef539 # scx_maestro: Introduce completely fair scheduling
47c5e013dea773a54149ff41462df3660ad8d396 # scx_maestro: Make enqueue + CPU kick more reliable
562688299dc397be6de8fe2d7f79e715ee1e3c43 # scx_maestro: Enforce preemption each tick on CPU contention
83295132d766b102c051e98548f3a08527cc8592 # scx_maestro: Temporarily drop sub-sched support
e7cee3552c4d2abc90b928d23e09e65863c9372a # scx_maestro: bump to 1.1.1
0395ca127bb9462958222599a24a1a697bf5f6c0 # scx_maestro: fix formatting
065349eed4c35af0c24b8a409706ef670fe84922 # scx_maestro: bump to 1.1.2
26732d79aeac73d50ee25e7919d9ffde12cd0c22 # Cargo: update dependencies to latest versions
54fb1880cc329caa2a8bfaa977b8262eb6c15a54 # scx_pandemonium: bump to 5.16.0
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_rlfifo \
     --exclude scx_characterize \
     --exclude xtask \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +
}
