3b4faccbd7fa69e9adc35cbe817655758fc220bc # scxtui: add D-Bus scheduler management TUI
e7cb2a05c79b72133fc240587a13ee9fe00a163e # scxtui: add journal log viewer
3cca31aea425d553f4f8e07532615e79225ca34e # scxtui: add scxtop monitor integration
