eccd7931913705d896f7826c8d808f2b549ed400 # scxtui: render running scheduler arguments as shell words
011879ea2973494836cf6e39b4b50b2189bba6af # scxtui: document the mode-argument preview
1fab8fce36982c2a6325c99311e93eedcd740333 # scxtui: add a session-only custom-arguments field
