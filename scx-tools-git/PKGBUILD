# Available profiles: “release”, “release-tiny”, “release-fast“
# See: https://github.com/sched-ext/scx-loader/blob/main/Cargo.toml
_mode=release

pkgname=scx-tools-git
_gitname=scx-loader
pkgver=1.1.2.r8.gcda5deb
pkgrel=2
epoch=1
pkgdesc='scx_loader: A DBUS Interface for Managing sched_ext Schedulers'
url='https://github.com/sched-ext/scx-loader'
arch=('x86_64')
license=('GPL-2.0-only')
depends=(
  polkit
  scx-scheds
)
makedepends=(
  cargo
  clang
  git
  llvm
  llvm-libs
)
options=(!lto)
provides=("scxctl" "scx-tools")
conflicts=("scxctl" "scx-tools")
source=("git+https://github.com/sched-ext/scx-loader")
sha256sums=('SKIP')

_backports=(
eab5b64bd0f95e016126789e7088346d523f4dce # scx_loader: Add chaos scheduler
b52acf8a001bc4fa50570970a06173d549aa9b2f # scx_loader: Add mitosis scheduler
0f60a65fcfaa549d00cf726517f7f9d6cd9b7dc1 # scx_loader: Add maestro scheduler
ca06e3d8bd544c47db9b86660dd1c9352c88c314 # scx_cake: update profiles flags
32393c9af385ff50ac4c97c182595fdec6391a66 # scxctl: parse scheduler arguments as shell words
7be3fe4930396923c1cb38cb2b2bdf7290c54a23 # scxctl: support shell-style scheduler arguments
9ed8b0cd11296e9c6d509d2b29e26fb285b729fd # scxctl: correct overclaims in argument-handling documentation
fed2769cbcb57a49279bf38664a85505d0945b26 # scxctl: make clippy happy
534cc5ec93a12cf506bc13e7c2d661b4d4e2c5cb # scxtui: query per-mode arguments instead of the configured-mode list
3a2a41225c6636dd857ecad8cdd2558b5c27b608 # scxtui: cache mode arguments, invalidate on daemon restart
81c2aef79ee9a417e622cffc85122512c40b92a9 # scxtui: preview configured mode arguments in the status panel
e10a6ed5216a2ebe08c58d80a5e35f79e87168e5 # scxtui: render running scheduler arguments as shell words
2c11de732a4893178c3b7a02423e0364115492ce # scxtui: document the mode-argument preview
3e26035dad1fa6dfa2fe8264e2a331dd3cc6e5eb # scxtui: add a session-only custom-arguments field
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --profile=$_mode --frozen --workspace
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' ! -name 'xtask' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +

  # Install runtime assets via xtask
  # (systemd units, D-Bus services, configs, sample files)
  ./target/$_mode/xtask install --destdir "$pkgdir"
}
