# Maintainer: Piotr Górski <lucjan.lucjanov@gmail.com>

# Available profiles: “release”, “release-tiny”, “release-fast“
# See: https://github.com/sched-ext/scx-loader/blob/main/Cargo.toml
_mode=release

pkgname=scx-tools-git
_gitname=scx-loader
pkgver=1.1.2.r4.gd343b37
pkgrel=4
epoch=1
pkgdesc='scx_loader: A DBUS Interface for Managing sched_ext Schedulers'
url='https://github.com/sched-ext/scx-loader'
arch=('x86_64')
license=('GPL-2.0-only')
depends=(
  polkit
  scx-scheds
)
makedepends=(
  cargo
  clang
  git
  llvm
  llvm-libs
)
options=(!lto)
provides=("scxctl" "scx-tools")
conflicts=("scxctl" "scx-tools")
source=("git+https://github.com/sched-ext/scx-loader")
sha256sums=('SKIP')

_backports=(
fd6740cba7c1ea2322468ea9e52255705d72b83f # scx_loader: Add chaos scheduler
5f40468d299be4652c6f0bf60b3de8d11095093d # scx_loader: Add mitosis scheduler
019dd89a3d2dc6b12a8bdb961132fd6ae67a2a45 # scx_loader: Add maestro scheduler
2f5d9c35ec5877dd35bfe4a50adb86eef170b830 # scx_cake: update profiles flags
1a721618c7371988a6db40442e2b41eb0c132bc9 # scxctl: fix formatting
a65c80807f361e4aa27fab319c483073933addb2 # scx_loader: refactor comments
feaf7cf862f7a20414ede195ca304664a17ccd83 # scxctl: update README.md
dd82b5197ff3514f19a4d4dfefc4a47fb01c912d # scxctl: improve mode/error handling and clarify output
35eb4c9d915b85c7b971da98fa089259ad2a6215 # scxctl: simplify mode reporting and lazy mode fetch
d6a474c249129a93a49fd6e0fde4a81e2585f418 # scxctl: fix formatting
)

_reverts=(
)

pkgver() {
  cd $_gitname
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --profile=$_mode --frozen --workspace
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' ! -name 'xtask' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +

  # Install runtime assets via xtask
  # (systemd units, D-Bus services, configs, sample files)
  ./target/$_mode/xtask install --destdir "$pkgdir"
}
