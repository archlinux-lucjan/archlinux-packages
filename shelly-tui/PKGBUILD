# Maintainer: Caroline Snyder <hirpeng@gmail.com>
# Maintainer: Piotr Górski <lucjan.lucjanov@gmail.com>

pkgname=shelly-tui
pkgver=3.2.0
pkgrel=2
# Head of the shelly-tui-development branch (PR #2136). Bump pkgrel, or
# pkgver when Shelly.Tui/build.zig.zon changes, whenever this moves.
_commit=cc279cc756ba9b808f79de35aaa6f1d08b98a49a
pkgdesc='Terminal interface for Shelly, a modern Arch package manager'
arch=('x86_64' 'aarch64')
url='https://github.com/Seafoam-Labs/Shelly-ALPM'
license=('GPL-3.0-only')
# The TUI drives the Shelly CLI and runs privileged operations through
# its own sudo PTY.
depends=('glibc' 'shelly-cli' 'sudo')
optdepends=('shelly-flatpak-backend: Flatpak tab')
makedepends=('git' 'zig>=0.17.1')
conflicts=('shelly-tui-git')
source=("${pkgname}::git+${url}.git#commit=${_commit}")
sha256sums=('97f96a3f35cbc611ab537260676c56c4619f4ec33406720daa75f206bebcbbbd')

_zig_build() {
  ZIG_GLOBAL_CACHE_DIR="${srcdir}/zig-global-cache" zig build \
    --cache-dir "${srcdir}/zig-cache" \
    -Dcpu=baseline \
    "$@"
}

prepare() {
  cd "${pkgname}/Shelly.Tui"

  # Fetch Zig dependencies up front so build() and check() work offline.
  _zig_build --fetch
}

build() {
  cd "${pkgname}/Shelly.Tui"

  # Release builds look up the CLI on PATH; pin it to the packaged binary.
  _zig_build \
    --prefix "${srcdir}/out" \
    -Dshelly-bin=/usr/bin/shelly \
    -Doptimize=safe
}

check() {
  cd "${pkgname}/Shelly.Tui"

  _zig_build test -Dshelly-bin=/usr/bin/shelly
}

package() {
  install -Dm755 "${srcdir}/out/bin/Shelly_Tui" "${pkgdir}/usr/bin/shelly-tui"
}
