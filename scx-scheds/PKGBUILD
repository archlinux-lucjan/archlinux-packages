# Maintainer: Piotr Górski <lucjan.lucjanov@gmail.com>
# Contributor: Tejun Heo <tj@kernel.org>

# Available profiles: “release”, “release-tiny”, “release-fast“
# See: https://github.com/sched-ext/scx/blob/main/Cargo.toml
_mode=release

pkgname=scx-scheds
_gitname=scx
pkgver=1.1.5
_tagver=1.1.5-devario8
pkgrel=1.4
pkgdesc='sched_ext schedulers and tools'
url='https://github.com/sched-ext/scx'
arch=('x86_64')
license=('GPL-2.0-only')
depends=(
  libelf
  polkit
  zlib
)
makedepends=(
  bpf-linker
  cargo
  clang
  git
  llvm
  rust-src
)
options=(!lto)
backup=('etc/default/scx')
source=("git+https://github.com/Seafoam-Labs/scx?signed#tag=v$_tagver")
sha256sums=('1cc90e1de87ed16a795472a01df9792a2bf346ae283c19183ddc9ad8659c7c52')
validpgpkeys=(
 399521CE9D6D65B35EEF0F8C79AFA05ABDB26C5A  # Piotr Gorski <lucjan.lucjanov@gmail.com>
)

_backports=(
2bd486e0816dc6f1d238f92bcacd32988c6f650c # scx_utils: Drop three more dependencies that nothing uses
894be97d888f4a8b86b0021775cef79a9770e2c9 # scheds: Drop dependencies that no scheduler source refers to
5df25ec485fc15bc82f2b9b5c87aa0596180b3a2 # scx_utils: Drop build-dependencies the build script does not use
)

_reverts=(
)

prepare() {
  cd $_gitname

  local _c _l
   for _c in "${_backports[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git cherry-pick --mainline 1 --no-commit "${_c}"
   done
   for _c in "${_reverts[@]}"; do
     if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
     git log --oneline "${_l}" "${_c}"
     git revert --mainline 1 --no-commit "${_c}"
   done

  local src
   for src in "${source[@]}"; do
     src="${src%%::*}"
     src="${src##*/}"
     [[ $src = *.patch ]] || continue
     echo "Applying patch $src..."
     patch -Np1 < "../$src"
   done

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $_gitname
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build \
     --profile=$_mode \
     --frozen \
     --workspace \
     --exclude scx_characterize \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests \
     --exclude scx_arena_libarena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/$_mode \
    -maxdepth 1 -type f -executable ! -name '*.so' ! -name 'xtask' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +

  # Runtime data via xtask: scx.service, /etc/default/scx,
  # /usr/share/scx/catalog.json, the scxcli polkit policy.
  # --source-dir keeps cargo out of package().
  ./target/$_mode/xtask install --source-dir . --destdir "$pkgdir"
}
